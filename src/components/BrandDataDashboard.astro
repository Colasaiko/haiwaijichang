---
import QuickFacts from './charts/QuickFacts.astro';
import QuickSelector from './charts/QuickSelector.astro';
import PlanTrafficChart from './charts/PlanTrafficChart.astro';
import BandwidthChart from './charts/BandwidthChart.astro';
import AnnualPriceChart from './charts/AnnualPriceChart.astro';
import PeriodPriceMatrix from './charts/PeriodPriceMatrix.astro';
import VerifiedCouponCard from './charts/VerifiedCouponCard.astro';
import CouponComparison from './charts/CouponComparison.astro';
import CouponEligibilityMatrix from './charts/CouponEligibilityMatrix.astro';
import NodeStatusChart from './charts/NodeStatusChart.astro';
import GlobalRouteCoverage from './charts/GlobalRouteCoverage.astro';
import UnlimitedTrafficChart from './charts/UnlimitedTrafficChart.astro';

const { brand } = Astro.props;

if (!brand || !brand.visualData) {
  return null;
}
---

<style is:inline>
  body.no-active-temp-coupon .show-if-temp-active { display: none !important; }
  body.has-active-temp-coupon .show-if-temp-expired { display: none !important; }
  body:not(.no-active-temp-coupon):not(.has-active-temp-coupon) .show-if-temp-expired { display: none !important; }
</style>

<div class="brand-data-dashboard">
  <QuickFacts brand={brand} />
  <QuickSelector brand={brand} />
  <PlanTrafficChart brand={brand} />
  <BandwidthChart brand={brand} />
  <AnnualPriceChart brand={brand} />
  <PeriodPriceMatrix brand={brand} />
  <VerifiedCouponCard brand={brand} />
  <CouponEligibilityMatrix brand={brand} />
  <CouponComparison brand={brand} />
  <UnlimitedTrafficChart brand={brand} />
  <NodeStatusChart brand={brand} />
  <GlobalRouteCoverage brand={brand} />
</div>
