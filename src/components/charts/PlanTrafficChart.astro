---
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.traffic) return null;

const data = brand.visualData.traffic;
const max = Math.max(...data.map(d => d.value));

---

<div class="mb-12 bg-brand-dark p-6 rounded-xl border border-white/5">
  <div class="mb-6">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      每月流量额度对比
    </h2>
    <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-mono">BAGGAGE / DATA ALLOWANCE</p>
    <p class="text-sm text-slate-400 mt-2">从 50GB 的学生版到 1TB 的宇宙版，套餐跨度较大，可以按自己的真实月流量选择。</p>
  </div>
  
  <div class="space-y-4 relative">
    <!-- Grid Lines -->
    <div class="absolute inset-0 flex justify-between px-16 pointer-events-none opacity-20">
      {[...Array(5)].map((_, i) => (
        <div class="h-full border-l border-dashed border-slate-500"></div>
      ))}
    </div>

    {data.map(item => {
      const width = (item.value / max) * 100;
      return (
        <div class="flex items-center relative z-10">
          <div class="w-20 sm:w-24 shrink-0 text-right pr-4 text-sm font-bold text-slate-300 truncate">
            {item.label}
          </div>
          <div class="flex-grow flex items-center h-8 bg-black/30 rounded-r-sm relative">
            <div 
              class="h-full bg-gradient-to-r from-brand-neon/80 to-brand-neon rounded-r-sm flex items-center shadow-[0_0_10px_rgba(56,189,248,0.2)]" 
              style={`width: ${width}%`}
            >
              <span class="absolute right-0 translate-x-[110%] text-xs font-mono font-bold text-brand-neon whitespace-nowrap">
                {item.display}
              </span>
            </div>
          </div>
          <div class="w-16 shrink-0"></div> <!-- spacing for absolute label -->
        </div>
      );
    })}
  </div>
  
  <div class="mt-6 pt-4 border-t border-white/10 flex justify-between items-center">
    <p class="text-xs text-slate-500">资料更新时间：2026-09-29<br/>来源：官方套餐页面</p>
  </div>
</div>
