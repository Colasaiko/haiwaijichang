---
const { brand } = Astro.props;

if (!brand) return null;

const hasSnapshot = brand.nodeSnapshot && brand.nodeSnapshot.regions;
const hasCoverage = brand.nodeCoverage && brand.nodeCoverage.regions && Array.isArray(brand.nodeCoverage.regions);

if (!hasSnapshot && !hasCoverage) return null;

const regionLabels = {
  eastAsia: "East Asia / 东亚",
  southeastAsia: "Southeast Asia / 东南亚",
  northAmerica: "North America / 北美",
  europe: "Europe / 欧洲",
  others: "Other Regions / 其他地区"
};

---

<div class="mb-12 bg-brand-navy p-6 rounded-xl border border-white/5">
  <div class="mb-8">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center mb-1">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      全球节点覆盖
    </h2>
    <p class="text-xs text-slate-500 uppercase tracking-widest font-mono">ROUTE COVERAGE</p>
  </div>
  
  {hasSnapshot ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {Object.keys(brand.nodeSnapshot.regions).map(key => {
        const nodes = brand.nodeSnapshot.regions[key];
        if (!nodes || nodes.length === 0) return null;
        
        return (
          <div class="bg-brand-dark p-5 rounded-lg border border-white/5 hover:border-brand-neon/30 transition-colors group">
            <h3 class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest border-b border-white/10 pb-2 mb-4 group-hover:text-brand-neon transition-colors">
              {regionLabels[key] || key}
            </h3>
            <div class="flex flex-wrap gap-2">
              {nodes.map(node => (
                <span class="inline-flex items-center bg-white/5 border border-white/10 text-slate-300 text-sm px-3 py-1 rounded">
                  {node}
                  {brand.nodeSnapshot.counts && brand.nodeSnapshot.counts[node] && (
                    <span class="ml-2 text-[10px] text-brand-neon font-mono bg-brand-neon/10 px-1 rounded">×{brand.nodeSnapshot.counts[node]}</span>
                  )}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div class="bg-brand-dark p-5 rounded-lg border border-white/5 hover:border-brand-neon/30 transition-colors group">
      <h3 class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest border-b border-white/10 pb-2 mb-4 group-hover:text-brand-neon transition-colors">
        {brand.nodeCoverage.totalText || '常规'}节点 · 持续扩展
      </h3>
      <div class="flex flex-wrap gap-2">
        {brand.nodeCoverage.regions.map(node => (
          <span class="inline-flex items-center bg-white/5 border border-white/10 text-slate-300 text-sm px-3 py-1 rounded">
            {node}
            {brand.nodeCoverage.counts && brand.nodeCoverage.counts[node] && (
              <span class="ml-2 text-[10px] text-brand-neon font-mono bg-brand-neon/10 px-1 rounded">×{brand.nodeCoverage.counts[node]}</span>
            )}
          </span>
        ))}
      </div>
    </div>
  )}
  
  <div class="mt-6 pt-4 border-t border-white/10">
    <p class="text-xs text-slate-500 font-mono">
      {hasSnapshot ? '注：节点和线路数量会动态调整，以上为单次快照覆盖情况，以当前后台为准。' : (brand.nodeCoverage?.note || '注：节点和线路数量会动态调整，以当前后台为准。')}
    </p>
  </div>
</div>
