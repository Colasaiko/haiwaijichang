---
const { brand } = Astro.props;

if (!brand || !brand.nodeSnapshot) return null;

const data = brand.nodeSnapshot;
const onlinePercent = Math.round((data.online / data.total) * 100);
const offlinePercent = 100 - onlinePercent;

---

<div class="mb-12 bg-brand-dark p-6 rounded-xl border border-white/5 flex flex-col md:flex-row items-center gap-8">
  
  <div class="md:w-1/2 w-full">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center mb-1">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      当前节点状态
    </h2>
    <p class="text-xs text-slate-500 mb-4 uppercase tracking-widest font-mono">LIVE NODE SNAPSHOT</p>
    
    <p class="text-sm text-slate-300 leading-relaxed">
      数据来源：{data.date} 官方后台单次快照。
    </p>
    <div class="mt-4 p-3 bg-brand-accent/10 border-l-2 border-brand-accent rounded-r text-xs text-brand-accent/90">
      注意：节点状态会随线路维护和网络调整变化，本图不代表长期可用率或 SLA。
    </div>
  </div>
  
  <div class="md:w-1/2 w-full flex items-center justify-center">
    <div class="relative w-48 h-48 flex items-center justify-center">
      <!-- Donut SVG -->
      <svg viewBox="0 0 100 100" class="w-full h-full transform -rotate-90 drop-shadow-[0_0_15px_rgba(74,222,128,0.2)]">
        <!-- Background circle -->
        <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="12" />
        
        <!-- Offline segment (underneath) -->
        <circle cx="50" cy="50" r="40" fill="none" stroke="#facc15" stroke-width="12" 
                stroke-dasharray="251.2" stroke-dashoffset="0" />
                
        <!-- Online segment -->
        <circle cx="50" cy="50" r="40" fill="none" stroke="#4ade80" stroke-width="12" 
                stroke-dasharray="251.2" stroke-dashoffset={`${251.2 * (1 - (data.online / data.total))}`} />
      </svg>
      
      <!-- Inner Text -->
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
        <span class="text-4xl font-black text-white font-mono leading-none">{data.total}</span>
        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">当前节点</span>
      </div>
    </div>
    
    <!-- Legend -->
    <div class="ml-8 flex flex-col space-y-4">
      <div class="flex items-center">
        <div class="w-3 h-3 rounded-full bg-green-400 mr-3 shadow-[0_0_8px_rgba(74,222,128,0.6)]"></div>
        <div class="flex flex-col">
          <span class="text-xs text-slate-400 uppercase tracking-wider font-mono">在线</span>
          <span class="text-lg font-bold text-white leading-none mt-1">{data.online}</span>
        </div>
      </div>
      <div class="flex items-center">
        <div class="w-3 h-3 rounded-full bg-brand-accent mr-3 shadow-[0_0_8px_rgba(250,204,21,0.6)]"></div>
        <div class="flex flex-col">
          <span class="text-xs text-slate-400 uppercase tracking-wider font-mono">离线</span>
          <span class="text-lg font-bold text-white leading-none mt-1">{data.offline}</span>
        </div>
      </div>
    </div>
  </div>

</div>
