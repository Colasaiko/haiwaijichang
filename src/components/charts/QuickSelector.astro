---
import { getBestCouponForPricing, getStandardCouponForPricing, getVerifiedCouponForPricing } from '../../utils/coupon.js';
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.traffic || !brand.pricing) return null;

const planMap = new Map();
brand.pricing.forEach(p => {
  if (!planMap.has(p.name)) planMap.set(p.name, []);
  planMap.get(p.name).push(p);
});

const periodOrder = ['月付', '季付', '半年付', '年付', '两年付', '三年付', '一次性'];

const cards = Array.from(planMap.entries()).map(([name, plans]) => {
  // Find the lowest available period
  plans.sort((a, b) => {
    let aIdx = periodOrder.indexOf(a.period);
    let bIdx = periodOrder.indexOf(b.period);
    if (aIdx === -1) aIdx = 99;
    if (bIdx === -1) bIdx = 99;
    return aIdx - bIdx;
  });

  const lowestPlan = plans[0];
  let priceStr = `${lowestPlan.originalPrice || lowestPlan.price || ''}/${lowestPlan.period === '一次性' ? '次' : lowestPlan.period.replace('付', '')}起`;
  
  let traffic = lowestPlan.traffic;
  
  let desc = lowestPlan.desc || '普通个人使用';
  let badge = lowestPlan.badge;
  if (!lowestPlan.desc) {
    if (name.includes('学生')) desc = '轻量使用\n偶尔访问';
    else if (traffic.includes('300')) desc = '中等流量';
    else if (traffic.includes('600')) desc = '视频 / 多设备';
    else if (traffic.includes('1.0TB') || traffic.includes('1000') || traffic.includes('1800') || traffic.includes('830')) desc = '大流量使用';
    else if (traffic.includes('120') || traffic.includes('150') || traffic.includes('80')) desc = '日常网页/视频';
  }
  
  const periodsWithCoupon = [];
  const periodsWithoutCoupon = [];
  let bestCouponName = null;
  let isTemp = false;

  const stdPeriodsWithCoupon = [];
  const stdPeriodsWithoutCoupon = [];
  let stdCouponName = null;

  const verifiedPeriods = [];
  let vCouponName = null;
  let vCouponDiscount = null;
  
  plans.forEach(p => {
    const activeCoupon = getBestCouponForPricing(brand, p);
    let stdCoupon = getStandardCouponForPricing(brand, p);
    
    if (activeCoupon) {
      periodsWithCoupon.push(p.period);
      if (!bestCouponName || activeCoupon.type === 'temporary') {
        bestCouponName = activeCoupon.code;
        isTemp = activeCoupon.type === 'temporary';
      }
    } else {
      periodsWithoutCoupon.push(p.period);
    }
    
    if (stdCoupon) {
      stdPeriodsWithCoupon.push(p.period);
      stdCouponName = stdCoupon.code;
    } else {
      stdPeriodsWithoutCoupon.push(p.period);
    }

    const vCoupon = getVerifiedCouponForPricing(brand, p);
    if (vCoupon) {
      verifiedPeriods.push(p.period);
      vCouponName = vCoupon.code;
      vCouponDiscount = vCoupon.discount;
    }
  });
  
  return {
    name,
    traffic,
    badge,
    priceStr,
    desc,
    periodsWithCoupon,
    periodsWithoutCoupon,
    bestCouponName,
    isTemp,
    stdPeriodsWithCoupon,
    stdPeriodsWithoutCoupon,
    stdCouponName,
    verifiedPeriods,
    vCouponName,
    vCouponDiscount
  };
});
---

<div class="mb-12">
  <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
    <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
    5 秒选套餐
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {cards.map(card => (
      <div class="bg-brand-dark border border-white/10 rounded-xl p-5 flex flex-col hover:border-brand-neon/50 transition-colors shadow-lg relative">
        <h3 class="text-lg font-bold text-white mb-1">{card.name}</h3>
        <div class="text-xs text-brand-neon font-mono mb-4">{card.traffic}</div>
        
        <div class="text-xl font-bold text-white mb-4">
          {card.priceStr}
        </div>
        
        <div class="text-sm text-slate-400 whitespace-pre-line mb-6 flex-grow leading-relaxed">
          {card.desc}
        </div>
        
        <div class="mt-auto">
          {card.periodsWithCoupon.length === 0 ? (
            card.verifiedPeriods.length > 0 ? (
              <div class="flex flex-col space-y-2">
                <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-emerald-400/10 text-emerald-400 border-emerald-400/20">
                  {card.vCouponName} · 一次性{card.vCouponDiscount}可用
                </div>
                <div class="text-[10px] text-slate-500">
                  {card.verifiedPeriods.join(' / ')}
                </div>
              </div>
            ) : (
              <div class="inline-block px-2 py-1 bg-slate-800 text-slate-400 text-xs rounded border border-slate-700">优惠码不适用</div>
            )
          ) : (
            <>
              <div class="flex-col space-y-2 show-if-temp-active flex">
                <div class={`inline-block self-start px-2 py-1 text-xs rounded border ${card.isTemp ? 'bg-brand-neon/10 text-brand-neon border-brand-neon/30' : 'bg-brand-accent/10 text-brand-accent border-brand-accent/20'}`}>
                  {card.bestCouponName} {card.isTemp ? '限时可用' : '可用'}
                </div>
                <div class="text-[10px] text-slate-500">
                  {card.periodsWithCoupon.join(' / ')} {card.periodsWithoutCoupon.length > 0 ? ` (排除 ${card.periodsWithoutCoupon.join('/')})` : ''}
                </div>
              </div>
              <div class="flex-col space-y-2 show-if-temp-expired">
                {card.stdPeriodsWithCoupon.length > 0 ? (
                  <>
                    <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-brand-accent/10 text-brand-accent border-brand-accent/20">
                      {card.stdCouponName} 可用
                    </div>
                    <div class="text-[10px] text-slate-500">
                      {card.stdPeriodsWithCoupon.join(' / ')} {card.stdPeriodsWithoutCoupon.length > 0 ? ` (排除 ${card.stdPeriodsWithoutCoupon.join('/')})` : ''}
                    </div>
                  </>
                ) : (
                  card.verifiedPeriods.length > 0 ? (
                    <>
                      <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-emerald-400/10 text-emerald-400 border-emerald-400/20">
                        {card.vCouponName} · 一次性{card.vCouponDiscount}可用
                      </div>
                      <div class="text-[10px] text-slate-500">
                        {card.verifiedPeriods.join(' / ')}
                      </div>
                    </>
                  ) : (
                    <div class="inline-block px-2 py-1 bg-slate-800 text-slate-400 text-xs rounded border border-slate-700">优惠码不适用</div>
                  )
                )}
              </div>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
