---
import { getBestCouponForPricing, getStandardCouponForPricing, getVerifiedCouponForPricing } from '../../utils/coupon.js';
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.traffic || !brand.pricing) return null;

const planMap = new Map();
brand.pricing.forEach(p => {
  if (!planMap.has(p.name)) planMap.set(p.name, []);
  planMap.get(p.name).push(p);
});

const periodOrder = ['月付', '季付', '半年付', '年付', '两年付', '三年付', '一次性'];

const cards = Array.from(planMap.entries()).map(([name, plans]) => {
  // Find the lowest available period
  plans.sort((a, b) => {
    let aIdx = periodOrder.indexOf(a.period);
    let bIdx = periodOrder.indexOf(b.period);
    if (aIdx === -1) aIdx = 99;
    if (bIdx === -1) bIdx = 99;
    return aIdx - bIdx;
  });

  const lowestPlan = plans[0];
  let priceStr = `${lowestPlan.originalPrice || lowestPlan.price || ''}/${lowestPlan.period === '一次性' ? '次' : lowestPlan.period.replace('付', '')}起`;
  
  let traffic = lowestPlan.traffic;
  
  let desc = lowestPlan.desc || '普通个人使用';
  let badge = lowestPlan.badge;
  if (!lowestPlan.desc) {
    if (name.includes('学生')) desc = '轻量使用\n偶尔访问';
    else if (traffic.includes('300')) desc = '中等流量';
    else if (traffic.includes('600')) desc = '视频 / 多设备';
    else if (traffic.includes('1.0TB') || traffic.includes('1000') || traffic.includes('1800') || traffic.includes('830')) desc = '大流量使用';
    else if (traffic.includes('120') || traffic.includes('150') || traffic.includes('80')) desc = '日常网页/视频';
  }
  
  if (brand.visualData && brand.visualData.selectorMeta && brand.visualData.selectorMeta[name]) {
    const meta = brand.visualData.selectorMeta[name];
    if (meta.desc) desc = meta.desc;
    if (meta.badge) badge = meta.badge;
  }
  
  const activeCouponsMap = new Map();
  const stdCouponsMap = new Map();
  const verifiedCouponsMap = new Map();
  
  plans.forEach(p => {
    const activeCoupon = getBestCouponForPricing(brand, p);
    let stdCoupon = getStandardCouponForPricing(brand, p);
    const vCoupon = getVerifiedCouponForPricing(brand, p);
    
    if (activeCoupon) {
      if (!activeCouponsMap.has(activeCoupon.code)) {
        activeCouponsMap.set(activeCoupon.code, { code: activeCoupon.code, isTemp: activeCoupon.type === 'temporary', discount: activeCoupon.discount, periods: [] });
      }
      activeCouponsMap.get(activeCoupon.code).periods.push(p.period);
    }
    
    if (stdCoupon) {
      if (!stdCouponsMap.has(stdCoupon.code)) {
        stdCouponsMap.set(stdCoupon.code, { code: stdCoupon.code, discount: stdCoupon.discount, periods: [] });
      }
      stdCouponsMap.get(stdCoupon.code).periods.push(p.period);
    }

    if (vCoupon) {
      if (!verifiedCouponsMap.has(vCoupon.code)) {
        verifiedCouponsMap.set(vCoupon.code, { code: vCoupon.code, discount: vCoupon.discount, periods: [] });
      }
      verifiedCouponsMap.get(vCoupon.code).periods.push(p.period);
    }
  });
  
  return {
    name,
    traffic,
    badge,
    priceStr,
    desc,
    activeCoupons: Array.from(activeCouponsMap.values()),
    stdCoupons: Array.from(stdCouponsMap.values()),
    verifiedCoupons: Array.from(verifiedCouponsMap.values())
  };
});
---

<div class="mb-12">
  <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
    <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
    5 秒选套餐
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {cards.map(card => (
      <div class="bg-brand-dark border border-white/10 rounded-xl p-5 flex flex-col hover:border-brand-neon/50 transition-colors shadow-lg relative">
        <h3 class="text-lg font-bold text-white mb-1">{card.name}</h3>
        <div class="text-xs text-brand-neon font-mono mb-4">{card.traffic}</div>
        
        <div class="text-xl font-bold text-white mb-4">
          {card.priceStr}
        </div>
        
        <div class="text-sm text-slate-400 whitespace-pre-line mb-6 flex-grow leading-relaxed">
          {card.desc}
        </div>
        
        <div class="mt-auto">
          {card.activeCoupons.length === 0 ? (
            card.verifiedCoupons.length > 0 ? (
              <div class="flex flex-col space-y-3">
                {card.verifiedCoupons.map(vc => (
                  <div class="flex flex-col space-y-1">
                    <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-emerald-400/10 text-emerald-400 border-emerald-400/20">
                      {vc.code} · 一次性{vc.discount}可用
                    </div>
                    <div class="text-[10px] text-slate-500">
                      {vc.periods.join(' / ')}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="inline-block px-2 py-1 bg-slate-800 text-slate-400 text-xs rounded border border-slate-700">优惠码不适用</div>
            )
          ) : (
            <>
              <div class="flex-col space-y-3 show-if-temp-active flex">
                {card.activeCoupons.map(ac => (
                  <div class="flex flex-col space-y-1">
                    <div class={`inline-block self-start px-2 py-1 text-xs rounded border ${ac.isTemp ? 'bg-brand-neon/10 text-brand-neon border-brand-neon/30' : 'bg-brand-accent/10 text-brand-accent border-brand-accent/20'}`}>
                      {ac.code} {ac.discount ? `· ${ac.isTemp ? '限时' : ''}${ac.discount}` : (ac.isTemp ? '限时可用' : '可用')}
                    </div>
                    <div class="text-[10px] text-slate-500">
                      {ac.periods.join(' / ')}
                    </div>
                  </div>
                ))}
              </div>
              <div class="flex-col space-y-3 show-if-temp-expired">
                {card.stdCoupons.length > 0 ? (
                  card.stdCoupons.map(sc => (
                    <div class="flex flex-col space-y-1">
                      <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-brand-accent/10 text-brand-accent border-brand-accent/20">
                        {sc.code} {sc.discount ? `· ${sc.discount}` : '可用'}
                      </div>
                      <div class="text-[10px] text-slate-500">
                        {sc.periods.join(' / ')}
                      </div>
                    </div>
                  ))
                ) : (
                  card.verifiedCoupons.length > 0 ? (
                    card.verifiedCoupons.map(vc => (
                      <div class="flex flex-col space-y-1">
                        <div class="inline-block self-start px-2 py-1 text-xs rounded border bg-emerald-400/10 text-emerald-400 border-emerald-400/20">
                          {vc.code} · 一次性{vc.discount}可用
                        </div>
                        <div class="text-[10px] text-slate-500">
                          {vc.periods.join(' / ')}
                        </div>
                      </div>
                    ))
                  ) : (
                    <div class="inline-block px-2 py-1 bg-slate-800 text-slate-400 text-xs rounded border border-slate-700">优惠码不适用</div>
                  )
                )}
              </div>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
