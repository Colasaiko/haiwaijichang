---
import { isCouponApplicableToPricing, getBestCouponForPricing } from '../../utils/coupon.js';
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.couponEligibility) return null;

// Determine if we show Standard Coupon or Temporary Best Coupons
let standardCoupon = null;
let useBestCoupons = false;

if (brand.coupon) {
  standardCoupon = brand.coupon;
} else if (brand.temporaryCoupons && brand.temporaryCoupons.length > 0) {
  useBestCoupons = true;
}

if (!standardCoupon && !useBestCoupons) return null;

const data = brand.visualData.couponEligibility;
const titleText = standardCoupon ? `${standardCoupon.code || "优惠码"} 可以用在哪些套餐？` : "当前活动优惠可以用在哪些套餐？";

const clientDate = new Date();
---

<div class={`mb-12 bg-brand-navy p-6 rounded-xl border border-white/5 ${!standardCoupon && useBestCoupons ? "show-if-temp-active" : ""}`}>
  <div class="mb-6">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {titleText}
    </h2>
    <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-mono">COUPON ELIGIBILITY</p>
    <p class="text-sm text-slate-400 mt-2">一目了然的优惠码适用范围。不同套餐的优惠资格不同，以下根据当前已确认规则显示；最终是否可用以官方结算页面实际结果为准。</p>
  </div>
  
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8">
    {data.map(item => {
      // Find all pricing entries for this plan
      const planName = item.plan || item.label;
      const entries = brand.pricing?.filter(p => p.name === planName) || [{ name: planName, period: '未知' }];
      
      let periodsWithCoupon = [];
      let mappedCodes = {};
      
      if (standardCoupon) {
        periodsWithCoupon = entries.filter(p => isCouponApplicableToPricing(brand, standardCoupon, p));
      } else {
        entries.forEach(p => {
          const best = getBestCouponForPricing(brand, p, clientDate);
          if (best) {
            periodsWithCoupon.push(p);
            mappedCodes[p.period] = best.code;
          }
        });
      }

      const isEligible = periodsWithCoupon.length > 0;
      
      return (
      <div class={`p-4 rounded-lg border flex flex-col items-center text-center transition-colors ${isEligible ? 'bg-brand-dark border-brand-neon/30 hover:border-brand-neon/60' : 'bg-slate-800/50 border-slate-700'}`}>
        <span class={`text-sm font-bold mb-2 ${isEligible ? 'text-white' : 'text-slate-400'}`}>
          {item.label}
        </span>
        {isEligible ? (
          <div class="flex flex-col items-center w-full">
            <div class="inline-flex items-center text-brand-neon text-xs font-bold bg-brand-neon/10 px-2 py-1 rounded-full border border-brand-neon/20 mb-2">
              <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              可用
            </div>
            {standardCoupon ? (
              <div class="text-[10px] text-slate-400 text-center leading-tight">
                {periodsWithCoupon.map(p => p.period).join('/')}
              </div>
            ) : (
              <div class="w-full text-left space-y-1 mt-1">
                {(() => {
                  const groups = {};
                  periodsWithCoupon.forEach(p => {
                    const c = mappedCodes[p.period];
                    if(!groups[c]) groups[c] = [];
                    groups[c].push(p.period);
                  });
                  return Object.entries(groups).map(([code, periods]) => (
                    <div class="text-[10px] text-slate-400 flex flex-col items-center justify-center">
                      <span>{periods.join('/')}</span>
                      <span class="text-brand-neon">{code}</span>
                    </div>
                  ));
                })()}
              </div>
            )}
            
            {entries.some(p => p.couponStatus === 'unverified') && (
              <div class="text-[10px] text-slate-500 text-center leading-tight mt-1 border-t border-slate-700 pt-1">
                <span class="text-yellow-500/80 mr-1">?</span>
                {entries.filter(p => p.couponStatus === 'unverified').map(p => p.period).join('/')}：未确认
              </div>
            )}
          </div>
        ) : (
          <div class="flex flex-col items-center">
            {entries.every(p => p.couponStatus === 'unverified') ? (
              <div class="inline-flex items-center text-yellow-500/80 text-xs font-bold bg-yellow-900/30 px-2 py-1 rounded-full border border-yellow-700/50">
                ? 未确认
              </div>
            ) : (
              <div class="inline-flex items-center text-slate-400 text-xs font-bold bg-slate-800 px-2 py-1 rounded-full border border-slate-600">
                <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                不适用
              </div>
            )}
          </div>
        )}
      </div>
      );
    })}
  </div>
</div>

{!standardCoupon && useBestCoupons && (
  <div class="mb-12 bg-brand-navy p-6 rounded-xl border border-white/5 show-if-temp-expired hidden">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center">
        <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        当前活动优惠可以用在哪些套餐？
      </h2>
      <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-mono">COUPON ELIGIBILITY</p>
      <p class="text-sm text-slate-400 mt-2">一目了然的优惠码适用范围。不同套餐的优惠资格不同，以下根据当前已确认规则显示；最终是否可用以官方结算页面实际结果为准。</p>
    </div>
    <div class="text-center py-10 bg-slate-800/50 rounded-lg border border-slate-700">
      <div class="text-slate-400">本轮活动已结束，当前暂无已确认常驻优惠码。</div>
    </div>
  </div>
)}
