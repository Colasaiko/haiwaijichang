---
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.couponEligibility) return null;

const data = brand.visualData.couponEligibility;
const couponCode = brand.coupon?.code || "优惠码";

---

<div class="mb-12 bg-brand-navy p-6 rounded-xl border border-white/5">
  <div class="mb-6">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {couponCode} 可以用在哪些套餐？
    </h2>
    <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-mono">COUPON ELIGIBILITY</p>
    <p class="text-sm text-slate-400 mt-2">一目了然的优惠码适用范围。部分轻量年付或不限时套餐因价格已是底价，不参与额外优惠。</p>
  </div>
  
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8">
    {data.map(item => (
      <div class={`p-4 rounded-lg border flex flex-col items-center text-center transition-colors ${item.eligible ? 'bg-brand-dark border-brand-neon/30 hover:border-brand-neon/60' : 'bg-slate-800/50 border-slate-700'}`}>
        <span class={`text-sm font-bold mb-3 ${item.eligible ? 'text-white' : 'text-slate-400'}`}>
          {item.label}
        </span>
        {item.eligible ? (
          <div class="inline-flex items-center text-brand-neon text-sm font-bold bg-brand-neon/10 px-3 py-1.5 rounded-full border border-brand-neon/20">
            <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            可用
          </div>
        ) : (
          <div class="inline-flex items-center text-slate-400 text-sm font-bold bg-slate-800 px-3 py-1.5 rounded-full border border-slate-600">
            <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
            不适用
          </div>
        )}
      </div>
    ))}
  </div>
</div>
