---
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.deviceLimits || brand.visualData.deviceLimits.length === 0) return null;

const data = brand.visualData.deviceLimits;
---

<div class="mb-12 bg-brand-navy p-6 rounded-xl border border-white/5">
  <div class="mb-6">
    <h2 class="text-xl font-bold text-white uppercase tracking-wider font-mono flex items-center">
      <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      同时在线设备限制
    </h2>
    <p class="text-xs text-slate-500 mt-1 uppercase tracking-widest font-mono">DEVICE LIMIT</p>
  </div>
  
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {data.map(item => (
      <div class="bg-brand-dark border border-white/10 rounded-lg p-4 flex flex-col items-center justify-center hover:border-brand-neon/40 transition-colors text-center group">
        <span class="text-xs text-slate-400 font-bold mb-2 uppercase group-hover:text-slate-300 transition-colors">{item.label}</span>
        <div class="flex items-baseline space-x-1">
          <span class="text-2xl font-black text-white font-mono">{item.value}</span>
          <span class="text-xs text-slate-500">台</span>
        </div>
      </div>
    ))}
  </div>
</div>
