---
import { getBestCouponForPricing, getDiscountMultiplier } from '../../utils/coupon.js';
const { brand } = Astro.props;

if (!brand || !brand.visualData || !brand.visualData.couponExample) return null;

const baseData = { ...brand.visualData.couponExample };
const pEntry = brand.pricing?.find(p => p.name === baseData.plan && p.period === baseData.period) || { name: baseData.plan, period: baseData.period };

const bestCoupon = getBestCouponForPricing(brand, pEntry);
if (!bestCoupon) return null;

let standardCoupon = null;
if (bestCoupon.type === 'temporary' && brand.coupon) {
  const isApplicable = (c, p) => {
    if (p.couponEligible === false) return false;
    if (c.excludedPlans && c.excludedPlans.some(x => p.name.includes(x))) return false;
    return true;
  };
  if (isApplicable(brand.coupon, pEntry)) {
    standardCoupon = { type: 'standard', ...brand.coupon };
  }
}

function processData(c) {
  const mult = getDiscountMultiplier(c);
  const after = parseFloat((baseData.before * mult).toFixed(2));
  const discount = (baseData.before - after).toFixed(2).replace(/\.00$/, '');
  const percent = c.discountPercent ? c.discountPercent.replace(/\D/g, '') : c.discount?.replace(/\D/g, '');
  return { ...baseData, coupon: c.code, after, discount, percent, note: baseData.note || `以上价格基于官方资料计算。` };
}

const data = processData(bestCoupon);
const fallbackData = standardCoupon ? processData(standardCoupon) : null;

const blocks = fallbackData 
  ? [{ d: data, classes: 'show-if-temp-active block' }, { d: fallbackData, classes: 'show-if-temp-expired block' }]
  : [{ d: data, classes: 'block' }];
---

{blocks.map(({d, classes}) => (
<div class={`mb-12 bg-brand-navy p-6 rounded-xl border border-brand-neon/30 shadow-[0_0_20px_rgba(56,189,248,0.1)] ${classes}`}>
  <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-white flex items-center">
        <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
        {d.coupon} 能省多少钱？
      </h2>
      <p class="text-sm text-slate-400 mt-2">
        以 {d.plan} {d.period} 为例。
      </p>
    </div>
    
    <div class="inline-flex flex-col items-center sm:items-end">
      <div class="flex items-center space-x-2 bg-brand-dark px-3 py-1.5 rounded border border-brand-neon/50">
        <span class="text-xs text-slate-400 uppercase tracking-widest">优惠码</span>
        <code class="text-brand-neon font-bold tracking-wider">{d.coupon}</code>
      </div>
    </div>
  </div>
  
  <div class="flex flex-col md:flex-row items-center gap-6 mt-8">
    <!-- Before -->
    <div class="w-full md:w-1/3 bg-brand-dark p-6 rounded-lg border border-white/5 flex flex-col items-center relative overflow-hidden group">
      <div class="absolute inset-0 bg-slate-800/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <span class="text-xs text-slate-500 uppercase tracking-widest mb-2 font-mono">官方标价</span>
      <span class="text-3xl font-bold text-slate-400 line-through decoration-brand-accent/50">¥{d.before}</span>
    </div>
    
    <!-- Arrow & Badge -->
    <div class="flex flex-col items-center justify-center -my-4 md:my-0 md:-mx-4 z-10">
      <div class="bg-brand-accent text-brand-dark font-black text-xl md:text-2xl px-4 py-2 rounded-full shadow-[0_0_15px_rgba(250,204,21,0.4)] transform hover:scale-110 transition-transform">
        省 ¥{d.discount}
      </div>
      <span class="text-xs font-bold text-brand-accent mt-2 bg-brand-dark px-2 py-0.5 rounded border border-brand-accent/30">{d.percent}% OFF</span>
    </div>
    
    <!-- After -->
    <div class="w-full md:w-1/3 bg-brand-dark p-6 rounded-lg border-2 border-brand-neon shadow-[0_0_20px_rgba(56,189,248,0.2)] flex flex-col items-center relative overflow-hidden">
      <div class="absolute top-0 right-0 w-16 h-16 bg-brand-neon/10 rounded-bl-full"></div>
      <span class="text-xs text-brand-neon uppercase tracking-widest mb-2 font-mono font-bold">使用后最终支付</span>
      <span class="text-4xl font-black text-white">¥{d.after}</span>
    </div>

    <!-- CTA -->
    <div class="w-full md:w-auto md:ml-auto flex shrink-0">
       {(brand.purchase?.url || brand.aff) ? (
        <a href={brand.purchase?.url || brand.aff} data-departure-link={brand.purchase?.cloaked !== false ? 'true' : undefined} class="w-full inline-flex items-center justify-center px-8 py-4 bg-brand-neon text-brand-dark font-bold text-lg rounded-md hover:bg-white transition-all uppercase tracking-widest shadow-[0_0_20px_rgba(56,189,248,0.3)]">
          快速购买
        </a>
      ) : null}
    </div>
  </div>
  
  <div class="mt-6 pt-4 border-t border-white/10 text-center md:text-left">
    <p class="text-[10px] text-slate-500 font-mono">{d.note}</p>
  </div>
</div>
))}
