---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'use-cases');
const { title, description, keywords, h1, heroText, destinations } = page.data;
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
>
  <!-- 1. Hero Section: Departure Gates -->
  <section class="relative pt-32 pb-16 overflow-hidden bg-brand-navy">
    <div class="absolute inset-0 z-0 flex items-center justify-center opacity-10 pointer-events-none">
      <svg class="w-full max-w-4xl" viewBox="0 0 800 400" fill="none" stroke="currentColor">
        <path d="M100,300 L200,100 L600,100 L700,300" stroke-width="2" stroke="var(--color-brand-neon)" stroke-dasharray="8 4" />
        <circle cx="200" cy="100" r="4" fill="var(--color-brand-neon)" />
        <circle cx="400" cy="100" r="4" fill="var(--color-brand-neon)" class="animate-pulse-slow" />
        <circle cx="600" cy="100" r="4" fill="var(--color-brand-neon)" />
      </svg>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 mb-8">
        <svg class="w-4 h-4 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <span class="text-xs font-mono tracking-[0.2em] text-slate-300 uppercase">Destination Selection Hall</span>
      </div>
      
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-8" set:html={h1}>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed" set:html={heroText}>
      </p>
    </div>
  </section>

  <!-- 2. The Gates Grid -->
  <section class="py-12 bg-brand-dark relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {destinations.map((dest) => (
          <div id={dest.id} class="bg-brand-navy border border-white/10 rounded-2xl overflow-hidden hover:border-white/20 transition-all flex flex-col group">
            
            <!-- Card Header: Gate Info -->
            <div class={`bg-gradient-to-br ${dest.bg} to-transparent border-b border-white/5 p-8 relative overflow-hidden`}>
              <div class="absolute right-0 top-0 text-9xl font-bold text-white/5 font-mono -mt-6 -mr-4 select-none pointer-events-none transition-transform group-hover:scale-110">
                {dest.gate.split(' ')[1]}
              </div>
              <div class="flex items-center space-x-3 mb-2 relative z-10">
                <div class="px-2 py-1 bg-black/40 border border-white/10 rounded text-[10px] font-mono tracking-widest text-slate-300">
                  {dest.gate}
                </div>
                <div class={`text-[10px] font-bold tracking-widest uppercase ${dest.color}`}>
                  {dest.enTitle}
                </div>
              </div>
              <h2 class="text-3xl font-bold text-white relative z-10 mt-2">{dest.title}</h2>
            </div>

            <!-- Card Body: Apps & Requirements -->
            <div class="p-8 flex-grow">
              <div class="mb-8">
                <h3 class="text-xs font-mono text-slate-500 tracking-widest uppercase mb-4">热门航班终点</h3>
                <div class="flex flex-wrap gap-2">
                  {dest.apps.map(app => (
                    <span class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-md text-sm text-slate-300">
                      {app}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mb-8 p-5 bg-black/30 rounded-xl border border-white/5">
                <h3 class="text-xs font-mono text-slate-500 tracking-widest uppercase mb-4 flex justify-between items-center">
                  <span>网络环境需求要求</span>
                  <span>PRIORITY</span>
                </h3>
                <div class="space-y-4">
                  {dest.requirements.map(req => (
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-bold text-white">{req.name}</span>
                      <div class="flex space-x-1">
                        {[1, 2, 3, 4, 5].map(level => (
                          <div class={`w-4 h-1.5 rounded-sm ${level <= req.level ? dest.barColor : 'bg-white/10'}`}></div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- FAQ / Advisory -->
              <div class="mb-4">
                <h3 class="text-xs font-mono text-slate-500 tracking-widest uppercase mb-2">航前疑难解答 (Advisory)</h3>
                <div class="bg-brand-accent/5 border border-brand-accent/20 rounded-lg p-5">
                  <p class="text-sm font-bold text-white mb-2 flex items-start">
                    <svg class="w-4 h-4 text-brand-accent mt-0.5 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Q: {dest.faq.q}
                  </p>
                  <p class="text-sm text-slate-400 pl-6 leading-relaxed">
                    A: {dest.faq.a}
                  </p>
                </div>
              </div>
            </div>

            <!-- Card Footer: CTA -->
            <div class="p-8 pt-0 mt-auto">
              <a href="/network" class="flex items-center justify-between w-full p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/30 rounded-lg transition-all group/btn">
                <span class="font-bold text-white tracking-widest uppercase text-sm">前往登机口查看可用航线</span>
                <svg class="w-5 h-5 text-slate-400 group-hover/btn:text-white transition-colors group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Bottom CTA -->
  <section class="py-24 bg-brand-navy border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-brand-neon/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
      </div>
      <h2 class="text-3xl font-bold mb-6">准备好规划您的行程了吗？</h2>
      <p class="text-slate-400 mb-10 max-w-2xl mx-auto">
        不管您的目的地在哪里，海外机场都有适合您的数字航线。如果您已经明确了需求，请前往全局网络面板，选择您的服务提供商。
      </p>
      <a href="/network" class="inline-block px-10 py-4 bg-brand-accent text-brand-dark font-bold rounded-sm uppercase tracking-wider hover:bg-yellow-400 transition-colors shadow-lg shadow-brand-accent/20">
        浏览全网航线航班表
      </a>
    </div>
  </section>

</Layout>
