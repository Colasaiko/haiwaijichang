---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import BrandDataDashboard from '../../components/BrandDataDashboard.astro';
import { getBestCouponForPricing, getStandardCouponForPricing, getVerifiedCouponForPricing, getDiscountMultiplier } from '../../utils/coupon.js';

export async function getStaticPaths() {
  const brandEntries = await getCollection('brands');
  return brandEntries.map(entry => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry, allEntries: brandEntries },
  }));
}

const { entry, allEntries } = Astro.props;
const brand = entry.data;
const allBrands = allEntries.map(e => ({ id: e.id, ...e.data })).sort((a, b) => (a.order || 999) - (b.order || 999));
const { Content, headings } = await render(entry);

const tocTree = [];
let currentH2 = null;
headings.filter(h => h.depth <= 3).forEach(h => {
  if (h.depth === 2 || h.depth === 1) {
    currentH2 = { ...h, children: [] };
    tocTree.push(currentH2);
  } else if (h.depth === 3 && currentH2) {
    currentH2.children.push(h);
  } else {
    tocTree.push({ ...h, children: [] });
  }
});

// Determine tags/features
const hasIPLC = brand.features.some(f => f.toLowerCase().includes('iplc'));
const hasIEPL = brand.features.some(f => f.toLowerCase().includes('iepl'));
const hasNetflix = brand.features.some(f => f.toLowerCase().includes('netflix') || f.includes('流媒体'));
const hasAI = brand.features.some(f => f.toLowerCase().includes('chatgpt') || f.toLowerCase().includes('ai') || f.toLowerCase().includes('claude'));

const title = brand.seoTitle || brand.title || `${brand.name} 怎么样？线路评测、套餐价格与使用教程 - 海外机场`;
const description = brand.seoDescription || brand.description || `详细了解 ${brand.name} 的线路质量、套餐价格、流媒体及 ChatGPT 解锁能力。为您提供最新优惠信息及真实使用评价，帮您判断 ${brand.name} 是否适合您。`;
const h1 = brand.h1 || brand.name;

const keywords = Array.isArray(brand.keywords) 
  ? brand.keywords.join(', ')
  : brand.keywords || `${brand.name}, ${brand.name}怎么样, ${brand.name}机场, ${brand.name}优惠码, ${brand.name}专线, ${brand.name}教程`;
const currentUrl = Astro.url.href;
const siteUrl = Astro.site?.toString() || Astro.url.origin;

// Fixed curated list of 10 related brands (excluding self)
const curatedSlugs = ['weifeng', 'feimao', 'firefly', 'wuyou', 'shanyue', 'lingmao', 'kuajie', 'jiuyun', 'baoyun', 'shenxing'];
const relatedBrands = curatedSlugs
  .filter(s => s !== brand.slug)
  .map(s => allBrands.find(b => b.slug === s))
  .filter(Boolean)
  .slice(0, 10);
---

<Layout title={title} description={description} keywords={keywords}>
  
  <!-- Schema.org for Brand/Service -->
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": brand.name,
    "description": brand.description || brand.heroDescription || `查看 ${brand.name} 详情`,
    "offers": brand.schemaPrice ? {
      "@type": "Offer",
      "price": brand.schemaPrice.value,
      "priceCurrency": brand.schemaPrice.currency
    } : undefined
  })} />


  <!-- Breadcrumb -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "品牌", "item": `${siteUrl}/brands` },
      { "@type": "ListItem", "position": 3, "name": brand.name, "item": currentUrl }
    ]
  })} />

  <section class="relative pt-32 pb-16 overflow-hidden bg-brand-navy border-b border-white/5">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-brand-dark/80 mix-blend-multiply"></div>
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-neon/5 to-transparent"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col md:flex-row items-start justify-between gap-8 md:gap-12">
        
        <!-- 左侧 58% -->
        <div class="w-full md:w-[58%] flex flex-col">
          <!-- Breadcrumb -->
          <nav class="flex items-center space-x-2 text-xs font-mono tracking-wider text-slate-500 mb-8 uppercase" aria-label="Breadcrumb">
              <a href="/" class="hover:text-brand-neon transition-colors">Home</a>
              <span>/</span>
              <a href="/brands" class="hover:text-brand-neon transition-colors">Brands</a>
              <span>/</span>
              <span class="text-brand-accent">{brand.name}</span>
          </nav>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 text-white leading-tight max-w-3xl">
              {brand.h1 || brand.title}
          </h1>
          
          <div class="flex flex-wrap gap-2 mb-6">
              {brand.lineType && <span class="text-[0.7rem] font-bold tracking-widest bg-brand-accent text-brand-dark px-3 py-1 rounded-sm uppercase">{brand.lineType}</span>}
              {brand.protocols?.map(p => <span class="text-[0.7rem] font-bold tracking-widest bg-purple-500 text-white px-3 py-1 rounded-sm uppercase border border-purple-400">{p}</span>)}
              {hasNetflix && <span class="text-[0.7rem] font-bold tracking-widest bg-white/10 text-white px-3 py-1 rounded-sm uppercase border border-white/20">Streaming</span>}
              {hasAI && <span class="text-[0.7rem] font-bold tracking-widest bg-white/10 text-white px-3 py-1 rounded-sm uppercase border border-white/20">AI Ready</span>}
          </div>
          
          <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
              {brand.heroDescription || "探索更多优质网络服务。"}
          </p>
        </div>

        <!-- 右侧 42% -->
        <div class="w-full md:w-[42%] flex flex-col">
          <!-- 品牌快速速览卡片 -->
          <div class="bg-brand-dark/50 border border-white/10 rounded-xl p-6 backdrop-blur-sm shadow-xl w-full">
            <h3 class="text-sm font-bold text-white mb-4 flex items-center">
              <svg class="w-5 h-5 text-brand-neon mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              品牌快速速览
            </h3>
            
            <ul class="space-y-3 mb-6">
              {(() => {
                const minPrice = brand.pricing && brand.pricing.length > 0 ? Math.min(...brand.pricing.map(p => p.price)) : null;
                const items = [];
                if (minPrice !== null && minPrice !== Infinity) items.push({ label: '最低套餐', value: `¥${minPrice}/起` });
                if (brand.lineType) items.push({ label: '线路类型', value: brand.lineType });
                if (brand.protocols && brand.protocols.length > 0) items.push({ label: '支持协议', value: brand.protocols.join(', ') });
                if (brand.nodeCoverage && (brand.nodeCoverage.total || brand.nodeCoverage.regions)) items.push({ label: '节点覆盖', value: brand.nodeCoverage.total || brand.nodeCoverage.regions?.join('/') });
                if (brand.deviceLimit) items.push({ label: '设备限制', value: String(brand.deviceLimit) });
                if (brand.speedLimit || brand.maxBandwidth) items.push({ label: '最高带宽', value: brand.maxBandwidth || brand.speedLimit });
                
                return items.slice(0, 5).map(item => (
                  <li class="flex justify-between items-center border-b border-white/5 pb-2 last:border-0 last:pb-0">
                    <span class="text-xs text-slate-400 font-mono uppercase">{item.label}</span>
                    <span class="text-sm text-white font-medium text-right max-w-[60%] line-clamp-1" title={item.value}>{item.value}</span>
                  </li>
                ));
              })()}
            </ul>

            <!-- 优惠区域 -->
            <div class="mb-6 p-4 rounded-lg bg-white/5 border border-white/10" id="hero-promo-container">
              {(() => {
                const hasTemp = brand.temporaryCoupons && brand.temporaryCoupons.length > 0;
                const std = brand.coupon;
                if (!hasTemp && !std) {
                  return <div class="text-center text-sm text-slate-400 py-2">暂无公开优惠</div>;
                }
                
                if (hasTemp) {
                  return (
                    <div id="hero-temp-promo" class="hidden flex-col items-center justify-center text-center">
                      <span class="text-[10px] font-bold bg-brand-accent text-brand-dark px-2 py-0.5 rounded uppercase mb-3 tracking-widest">限时优惠活动</span>
                      <div class="flex flex-col gap-2 w-full" id="hero-temp-list"></div>
                      <span id="hero-temp-expiry" class="text-[10px] text-slate-400 mt-3 border-t border-white/10 pt-2 w-full"></span>
                    </div>
                  );
                } else {
                  return (
                    <div class="flex flex-col items-center justify-center text-center">
                      <span class="text-[10px] font-bold bg-white/20 text-white px-2 py-0.5 rounded uppercase mb-2 tracking-widest">常驻优惠</span>
                      <code class="text-brand-neon font-bold text-lg tracking-widest">{std.code}</code>
                      <span class="text-brand-accent text-sm mt-1">{std.discount}</span>
                    </div>
                  );
                }
              })()}
            </div>
            
            <!-- 按钮 -->
            <div class="flex flex-col gap-3">
              {brand.purchase?.url || brand.aff ? (
                <a href={brand.purchase?.url || brand.aff} target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center px-6 py-3.5 bg-brand-neon text-brand-dark font-bold rounded-sm hover:bg-white transition-all uppercase tracking-widest shadow-[0_0_15px_rgba(56,189,248,0.2)]">
                  快速购买
                </a>
              ) : (
                <span class="w-full flex items-center justify-center px-6 py-3.5 bg-white/10 text-slate-400 font-bold rounded-sm cursor-not-allowed uppercase tracking-widest">
                  购买入口待补充
                </span>
              )}
              
              {brand.telegram && (
                <a href={brand.telegram} target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center px-6 py-3 bg-sky-500 text-white font-bold rounded-sm hover:bg-sky-400 transition-all text-sm shadow-[0_0_10px_rgba(14,165,233,0.3)]">
                  Telegram 频道
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
    
    {brand.temporaryCoupons && brand.temporaryCoupons.length > 0 && (
      <script is:inline define:vars={{ temps: brand.temporaryCoupons, stdCoupon: brand.coupon }}>
        (function() {
          const now = Date.now();
          const activeTemps = temps.filter(c => {
            if (c.manualActive === false) return false;
            if (c.manualActive === true) {
              if (c.startsAt && now < new Date(c.startsAt).getTime()) return false;
              if (c.expiresAt && now > new Date(c.expiresAt).getTime()) return false;
              return true;
            }
            if (!c.startsAt || !c.expiresAt) return false;
            const s = new Date(c.startsAt).getTime();
            const e = new Date(c.expiresAt).getTime();
            return now >= s && now <= e;
          });

          const container = document.getElementById('hero-temp-promo');
          const list = document.getElementById('hero-temp-list');
          const expiry = document.getElementById('hero-temp-expiry');
          const root = document.getElementById('hero-promo-container');
          
          if (activeTemps.length > 0) {
            activeTemps.sort((a, b) => (b.priority || 0) - (a.priority || 0));
            
            if (container && list) {
              container.style.display = 'flex';
              list.innerHTML = activeTemps.map(c => `
                <div class="flex items-center justify-between bg-black/20 p-2 rounded border border-white/5">
                  <div class="flex flex-col text-left">
                    <span class="text-[10px] text-slate-400 mb-0.5">${c.scope || '-'}</span>
                    <div class="flex items-baseline gap-2">
                      <code class="text-brand-neon font-bold text-sm tracking-widest">${c.code}</code>
                      <span class="text-brand-accent text-xs font-bold">${c.discount}</span>
                    </div>
                  </div>
                  <button class="bg-brand-navy border border-white/10 hover:border-brand-neon/50 hover:bg-brand-navy/80 text-white text-[10px] px-3 py-1.5 rounded cursor-pointer transition-colors" onclick="navigator.clipboard.writeText('${c.code}').then(()=>{this.textContent='已复制';setTimeout(()=>this.textContent='复制',2000)})">复制</button>
                </div>
              `).join('');
              
              const earliestExpiry = activeTemps.map(c => c.expiresAt).filter(Boolean).sort()[0];
              if (earliestExpiry && expiry) {
                const expDate = new Date(earliestExpiry);
                expiry.textContent = (expDate.getMonth() + 1) + '月' + expDate.getDate() + '日截止，请抓紧时间！';
              }
            }
          } else {
            if (stdCoupon) {
              root.innerHTML = `
                <div class="flex flex-col items-center justify-center text-center">
                  <span class="text-[10px] font-bold bg-white/20 text-white px-2 py-0.5 rounded uppercase mb-2 tracking-widest">常驻优惠</span>
                  <code class="text-brand-neon font-bold text-lg tracking-widest">${stdCoupon.code}</code>
                  <span class="text-brand-accent text-sm mt-1">${stdCoupon.discount}</span>
                </div>
              `;
            } else {
              root.innerHTML = `<div class="text-center text-sm text-slate-400 py-2">暂无公开优惠</div>`;
            }
          }
        })();
      </script>
    )}
  </section>

  <!-- Details Content -->
  <section class="py-16 bg-brand-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-12">
      
      <!-- Main Content -->
      <div class="md:col-span-2 space-y-12">
        <BrandDataDashboard brand={brand} />

        <div>
          <h2 class="text-2xl font-bold text-white mb-6 pb-4 border-b border-white/10 flex items-center">
            <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
            核心特性与优势
          </h2>
          <ul class="space-y-4">
            {brand.features.map((f) => (
              <li class="flex items-start text-slate-300">
                <svg class="w-6 h-6 text-brand-neon mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-base leading-relaxed">{f}</span>
              </li>
            ))}
          </ul>
        </div>

                {brand.serviceIntro && (
          <div class="prose prose-invert prose-brand max-w-none">
            <h2 class="text-2xl font-bold text-white mb-6 pb-4 border-b border-white/10 flex items-center mt-12">
              <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
              关于 {brand.name} 的线路与服务信息
            </h2>
            {Array.isArray(brand.serviceIntro) ? (
              brand.serviceIntro.map((para) => <p>{para}</p>)
            ) : (
              <p>{brand.serviceIntro}</p>
            )}
          </div>
        )}

        <div class="prose prose-invert prose-brand max-w-none brand-content-rendered">
          <Content />
          
          <h3>使用建议与支持</h3>
          <p>
            如果你是新手，建议先参考我们的 <a href="/blog/what-is-airport-subscription" class="text-brand-neon hover:underline">机场订阅是什么？新手指南</a>。购买 {brand.name} 的服务后，将获取到的订阅链接导入本地客户端即可开始使用。如遇连接异常，请优先参考我们的<a href="/help">帮助中心故障排查</a>。
          </p>
        </div>
  {brand.pricing && brand.pricing.length > 0 && (
    <div class="mt-12 mb-8">
      <h3 class="text-2xl font-bold text-white mb-6 pb-4 border-b border-white/10 flex items-center">
        <span class="w-1.5 h-6 bg-brand-neon mr-3 rounded-sm"></span>
        套餐与价格
      </h3>
      <div class="overflow-x-auto w-full border border-white/10 rounded-lg">
        <table class="min-w-full text-sm text-left text-slate-300 border-collapse">
          <thead class="text-xs uppercase bg-white/5 text-slate-400 border-b border-white/10">
            <tr>
              <th class="px-5 py-4 font-bold tracking-wider">套餐名称</th>
              <th class="px-5 py-4 font-bold tracking-wider">包含流量</th>
              <th class="px-5 py-4 font-bold tracking-wider">周期</th>
              <th class="px-5 py-4 font-bold tracking-wider">价格</th>
              <th class="px-5 py-4 font-bold tracking-wider">优惠情况</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 bg-brand-dark/30">
            {brand.pricing.map((p) => (
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-5 py-4 font-bold text-white align-middle">{p.name || '-'}</td>
                <td class="px-5 py-4 align-middle">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-neon/10 text-brand-neon border border-brand-neon/20">
                    {p.traffic || '-'}
                  </span>
                </td>
                <td class="px-5 py-4 align-middle">{p.period || '-'}</td>
                <td class="px-5 py-3 align-middle">
                  <div class="flex flex-col space-y-1">
                    {(() => {
                      const basePrice = p.price || p.originalPrice || '-';
                      const getDisc = (c) => {
                        if (!c) return null;
                        if (p.discountPrice && c.type !== 'temporary') return p.discountPrice;
                        const origMatch = String(basePrice).match(/\d+(\.\d+)?/);
                        if (origMatch) {
                          const val = parseFloat(origMatch[0]);
                          const mult = getDiscountMultiplier(c);
                          const prefix = String(basePrice).includes('¥') ? '¥' : '';
                          return prefix + (val * mult).toFixed(2).replace(/\.00$/, '');
                        }
                        return null;
                      };

                      const coupon = getBestCouponForPricing(brand, p);
                      if (!coupon) {
                        return <span class="text-sm font-bold text-brand-neon">{basePrice}</span>;
                      }

                      const discActive = getDisc(coupon);
                      let html = [];
                      
                      if (discActive) {
                        html.push(
                          <div class="flex-col show-if-temp-active">
                            <span class="text-sm font-bold text-brand-neon block">{discActive}</span>
                            <span class="text-xs text-slate-500 line-through block">{basePrice}</span>
                          </div>
                        );
                      } else {
                        html.push(<span class="text-sm font-bold text-brand-neon show-if-temp-active block">{basePrice}</span>);
                      }

                      if (coupon.type === 'temporary') {
                        const stdCoupon = getStandardCouponForPricing(brand, p);
                        const discExpired = getDisc(stdCoupon);
                        if (discExpired) {
                          html.push(
                            <div class="flex-col show-if-temp-expired">
                              <span class="text-sm font-bold text-brand-accent block">{discExpired}</span>
                              <span class="text-xs text-slate-500 line-through block">{basePrice}</span>
                            </div>
                          );
                        } else {
                          html.push(<span class="text-sm font-bold text-brand-neon show-if-temp-expired block">{basePrice}</span>);
                        }
                      } else {
                        if (discActive) {
                          html.push(
                            <div class="flex-col show-if-temp-expired">
                              <span class="text-sm font-bold text-brand-accent block">{discActive}</span>
                              <span class="text-xs text-slate-500 line-through block">{basePrice}</span>
                            </div>
                          );
                        } else {
                          html.push(<span class="text-sm font-bold text-brand-neon show-if-temp-expired block">{basePrice}</span>);
                        }
                      }
                      return html;
                    })()}
                  </div>
                </td>
                <td class="px-5 py-3 align-middle text-xs">
                  {(() => {
                    const coupon = getBestCouponForPricing(brand, p);
                    
                    if (!coupon) {
                      const vCoupon = getVerifiedCouponForPricing(brand, p);
                      if (vCoupon) {
                        return <span class="text-emerald-400 bg-emerald-400/10 border-emerald-400/20 border px-2 py-1 rounded whitespace-nowrap inline-block">{vCoupon.code} · 一次性{vCoupon.discount}可用</span>;
                      }
                      return <span class="text-slate-500 bg-slate-800 px-2 py-1 rounded inline-block">不适用</span>;
                    }

                    let html = [];
                    html.push(
                      <div class="show-if-temp-active">
                        <span class={`${coupon.type === 'temporary' ? 'text-brand-neon bg-brand-neon/10 border-brand-neon/20' : 'text-brand-accent bg-brand-accent/10 border-brand-accent/20'} border px-2 py-1 rounded whitespace-nowrap inline-block`}>
                          {coupon.code} · {coupon.type === 'temporary' ? '限时' : ''}{coupon.discount}
                        </span>
                      </div>
                    );

                    if (coupon.type === 'temporary') {
                      const stdCoupon = getStandardCouponForPricing(brand, p);
                      if (stdCoupon) {
                        html.push(
                          <div class="show-if-temp-expired mt-1">
                            <span class="text-brand-accent bg-brand-accent/10 border-brand-accent/20 border px-2 py-1 rounded whitespace-nowrap inline-block">
                              {stdCoupon.code} · {stdCoupon.discount}
                            </span>
                          </div>
                        );
                      } else {
                        const vCoupon = getVerifiedCouponForPricing(brand, p);
                        if (vCoupon) {
                          html.push(
                            <div class="show-if-temp-expired mt-1">
                              <span class="text-emerald-400 bg-emerald-400/10 border-emerald-400/20 border px-2 py-1 rounded whitespace-nowrap inline-block">
                                {vCoupon.code} · 一次性{vCoupon.discount}可用
                              </span>
                            </div>
                          );
                        } else {
                          html.push(
                            <div class="show-if-temp-expired mt-1">
                              <span class="text-slate-500 bg-slate-800 px-2 py-1 rounded inline-block">不适用</span>
                            </div>
                          );
                        }
                      }
                    } else {
                      html.push(
                        <div class="show-if-temp-expired mt-1">
                          <span class="text-brand-accent bg-brand-accent/10 border-brand-accent/20 border px-2 py-1 rounded whitespace-nowrap inline-block">
                            {coupon.code} · {coupon.discount}
                          </span>
                        </div>
                      );
                    }
                    return html;
                  })()}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
  <div class="mt-8 pt-8 border-t border-white/10">
    <h3 class="text-xl font-bold text-white mb-4">准备好体验 {brand.name} 了吗？</h3>
    {(brand.purchase?.url || brand.aff) ? (
      <a href={brand.purchase?.url || brand.aff} data-departure-link={brand.purchase?.cloaked !== false ? 'true' : undefined} class="inline-flex items-center justify-center px-8 py-3 bg-brand-neon text-brand-dark font-bold rounded-sm hover:bg-white transition-all tracking-widest shadow-[0_0_15px_rgba(56,189,248,0.2)]">
        {brand.purchase?.label || '前往购买'}
      </a>
    ) : (
      <span class="inline-flex items-center justify-center px-8 py-3 bg-white/10 text-slate-400 font-bold rounded-sm cursor-not-allowed tracking-widest">
        购买入口待补充
      </span>
    )}
  </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-8 sticky top-24 self-start h-max max-h-[calc(100vh-8rem)] overflow-y-auto custom-scrollbar pt-4 pb-8">
        <!-- TOC -->
        {headings && headings.length > 0 && (
          <div class="bg-brand-dark border border-white/5 p-6 rounded-xl hidden lg:block">
            <h3 class="text-xs font-bold font-mono tracking-widest text-slate-500 uppercase mb-4 flex items-center">
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              目录导航
            </h3>
            <nav class="toc">
              <ul class="space-y-3">
                {tocTree.map(h2 => (
                  <li>
                    {h2.children.length > 0 ? (
                      <details class="group" open={!h2.text.toUpperCase().includes('FAQ')}>
                        <summary class="flex items-center justify-between cursor-pointer list-none text-sm font-medium text-slate-400 hover:text-brand-neon transition-colors border-l-2 border-transparent hover:border-brand-neon pl-3 -ml-[14px]">
                          <a href={"#" + h2.slug} class="toc-link block flex-grow" >{h2.text}</a>
                          <svg class="w-3 h-3 transition-transform group-open:rotate-180 text-slate-500 ml-2 shrink-0 opacity-50 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </summary>
                        <ul class="pl-4 mt-2 space-y-2 border-l border-white/5 ml-[2px]">
                          {h2.children.map(h3 => (
                            <li>
                              <a href={"#" + h3.slug} class="toc-link block text-xs font-medium text-slate-500 hover:text-brand-neon transition-colors pl-3 border-l-2 border-transparent hover:border-brand-neon -ml-[2px]">
                                {h3.text}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <a href={"#" + h2.slug} class="toc-link block text-sm font-medium text-slate-400 hover:text-brand-neon transition-colors border-l-2 border-transparent hover:border-brand-neon pl-3 -ml-[14px]">
                        {h2.text}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
            <style>
              details > summary::-webkit-details-marker {
                display: none;
              }
            </style>
          </div>
        )}
        <!-- Related Articles -->
        <div class="bg-brand-dark border border-white/5 p-6 rounded-xl">
          <h3 class="text-xs font-bold font-mono tracking-widest text-slate-500 uppercase mb-4">关于这个品牌的内容</h3>
          <ul class="space-y-4">
            <li>
              <a href="/help/getting-started" class="group flex flex-col">
                <span class="text-sm font-bold text-slate-300 group-hover:text-brand-neon transition-colors">新手如何导入节点？</span>
                <span class="text-xs text-slate-500 mt-1">适用于 {brand.name} 的基础指南</span>
              </a>
            </li>
            <li>
              <a href={hasAI ? "/help/ai-tools-access" : "/help/streaming-region-locked"} class="group flex flex-col">
                <span class="text-sm font-bold text-slate-300 group-hover:text-brand-neon transition-colors">{hasAI ? "如何解决 ChatGPT 封号问题？" : "Netflix 地区限制如何突破？"}</span>
                <span class="text-xs text-slate-500 mt-1">进阶使用场景</span>
              </a>
            </li>
            <li>
              <a href="/help/how-to-check-plan-status" class="group flex flex-col">
                <span class="text-sm font-bold text-slate-300 group-hover:text-brand-neon transition-colors">套餐与流量查询方法</span>
                <span class="text-xs text-slate-500 mt-1">管理您的 {brand.name} 账户</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Similar Brands -->
        <div class="bg-brand-dark border border-white/5 p-6 rounded-xl">
          <h3 class="text-xs font-bold font-mono tracking-widest text-slate-500 uppercase mb-4">站内其他相关品牌</h3>
          <ul class="space-y-3">
            {relatedBrands.map(rb => (
              <li>
                <a href={`/brands/${rb.slug}`} class="flex items-center justify-between group">
                  <span class="text-sm font-bold text-slate-300 group-hover:text-white transition-colors">{rb.name}</span>
                  <svg class="w-4 h-4 text-slate-500 group-hover:text-brand-neon transition-colors transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll(".toc-link");
    if (links.length === 0) return;
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(a => {
            a.classList.remove('text-brand-neon', 'border-brand-neon');
            if (a.getAttribute('href') === '#' + entry.target.id) {
              a.classList.add('text-brand-neon', 'border-brand-neon');
              a.classList.remove('text-slate-400', 'border-transparent');
            } else {
              a.classList.add('text-slate-400', 'border-transparent');
            }
          });
        }
      });
    }, { rootMargin: '-20% 0px -80% 0px' });
    
    document.querySelectorAll('.brand-content-rendered h2, .brand-content-rendered h3').forEach(h => {
      if (h.id) observer.observe(h);
    });
  });
</script>


<style is:global>
  .brand-content-rendered h2 {
    font-size: 1.875rem !important; /* text-3xl */
    line-height: 2.25rem !important;
    font-weight: 700 !important;
    color: white !important;
    margin-top: 3rem !important;
    margin-bottom: 1.5rem !important;
    scroll-margin-top: 6rem;
  }
  .brand-content-rendered h3 {
    font-size: 1.5rem !important; /* text-2xl */
    line-height: 2rem !important;
    font-weight: 700 !important;
    color: #f8fafc !important; /* slate-50 */
    margin-top: 2rem !important;
    margin-bottom: 1rem !important;
    scroll-margin-top: 6rem;
  }
  .brand-content-rendered h2::before, .brand-content-rendered h3::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 1em;
    background-color: #38bdf8; /* brand-neon */
    margin-right: 0.75rem;
    vertical-align: -0.15em;
    border-radius: 2px;
  }
</style>


  <!-- Floating Purchase Button -->
  {(brand.purchase?.url || brand.aff) && (
    <div id="floating-purchase" class="fixed bottom-6 right-6 z-50 opacity-0 translate-y-4 pointer-events-none transition-all duration-300">
      <a 
        href={brand.purchase?.url || brand.aff} 
        data-departure-link={brand.purchase?.cloaked !== false ? 'true' : undefined}
        class="flex items-center gap-2 px-6 py-3 bg-brand-neon text-brand-dark font-bold text-sm rounded-full shadow-[0_4px_20px_rgba(56,189,248,0.4)] hover:bg-white hover:shadow-[0_4px_30px_rgba(56,189,248,0.6)] transition-all uppercase tracking-wider"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        购买 {brand.name}
      </a>
    </div>
  )}


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fab = document.getElementById("floating-purchase");
    if (!fab) return;
    
    let lastScrollY = 0;
    const showThreshold = 600;
    
    const update = () => {
      const y = window.scrollY;
      const atBottom = (window.innerHeight + y) >= (document.body.offsetHeight - 100);
      
      if (y > showThreshold && !atBottom) {
        fab.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
        fab.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
      } else {
        fab.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
        fab.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
      }
      lastScrollY = y;
    };
    
    window.addEventListener("scroll", update, { passive: true });
    update();
  });
</script>

</Layout>
