---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Simple sort by date string (if properly formatted YYYY-MM-DD)
posts.sort((a, b) => {
  const dA = new Date(a.data.date).getTime() || 0;
  const dB = new Date(b.data.date).getTime() || 0;
  return dB - dA;
});

const title = "博客与教程大全 | 2026机场推荐、梯子选择与翻墙知识库";
const description = "探索我们深度的科学上网与网络加速知识库。包含 2026 最新机场排行榜解析、Clash 教程、专线与流媒体节点挑选指南。";
---
<Layout title={title} description={description}>
  <section class="pt-32 pb-16 bg-brand-navy border-b border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 flex items-center justify-center opacity-10 pointer-events-none">
      <div class="w-[800px] h-[800px] border-[40px] border-brand-neon rounded-full blur-[120px]"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 uppercase tracking-tight">Official <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-neon to-brand-accent">Blog</span></h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        从“机场节点怎么选”到“AI与流媒体完整解锁教程”，为您提供最专业、透明的 2026 梯子与翻墙网络知识。
      </p>
    </div>
  </section>

  <section class="py-16 bg-brand-dark min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="group flex flex-col bg-brand-navy border border-white/5 rounded-xl p-6 hover:border-brand-neon/50 hover:bg-brand-navy/80 transition-all">
          <div class="flex items-center text-xs font-mono text-brand-accent mb-4 uppercase">
            {post.data.date || 'LATEST UPDATE'}
          </div>
          <h2 class="text-xl font-bold text-white mb-3 group-hover:text-brand-neon transition-colors line-clamp-2">{post.data.title}</h2>
          <p class="text-sm text-slate-400 mb-6 flex-grow line-clamp-3">{post.data.description}</p>
          <div class="text-xs font-bold font-mono text-white group-hover:text-brand-neon flex items-center uppercase tracking-wider">
            阅读全文 <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
