---
import Layout from '../layouts/Layout.astro';
import brands from '../data/brands.json';
---

<Layout 
  title="海外机场推荐 2026 - 稳定专线与优质 VPN 梯子排行榜 | Overseas Airport"
  description="2026 稳定便宜机场推荐，海外机场为您精选高性价比、专线网络与低延迟的全球节点。提供流媒体解锁、AI 工具访问、科学上网梯子推荐及各平台 VPN 客户端配置教程。"
  keywords="机场推荐, 机场推荐 2026, 稳定机场推荐, 便宜机场推荐, 专线机场推荐, 机场排行榜, 2026 机场排行榜, 梯子推荐, 翻墙梯子推荐, 科学上网梯子推荐"
>
  <!-- SEO: FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "海外机场是什么？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "海外机场是一个提供全球网络加速与安全连接的服务平台，致力于为您在访问海外网站、使用 AI 工具、流媒体娱乐及远程办公时，提供更稳定顺畅的网络体验。"
        }
      },
      {
        "@type": "Question",
        "name": "适合哪些使用场景？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "主要适用于需要访问国际网络资源的用户，例如使用海外 AI 工具、观看跨国流媒体、参与跨国远程会议及开发者进行跨区域代码部署等场景。"
        }
      }
    ]
  })} />

  <!-- 1. Hero Section -->
  <section class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden">
    <!-- Background grid/map elements -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(var(--color-brand-neon) 1px, transparent 1px); background-size: 40px 40px; mask-image: linear-gradient(to bottom, black 40%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent 100%);"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-neon/10 border border-brand-neon/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-neon animate-pulse-slow"></span>
          <span class="text-xs font-mono tracking-widest text-brand-neon">OVERSEAS AIRPORT · GLOBAL NETWORK</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
          海外机场<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400">连接你的下一站</span>
        </h1>
        
        <p class="text-lg text-slate-400 mb-8 max-w-xl leading-relaxed">
          为海外网站、流媒体、AI 工具、远程办公与日常网络访问场景，提供更顺畅的全球网络连接体验。
        </p>
        
        <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 mb-10">
          <a href="#board" class="inline-flex items-center justify-center px-8 py-3.5 text-base font-bold text-brand-dark bg-brand-accent hover:bg-yellow-400 rounded-sm transition-colors uppercase tracking-wider">
            立即登机
          </a>
          <a href="#destinations" class="inline-flex items-center justify-center px-8 py-3.5 text-base font-medium text-white border border-white/20 hover:bg-white/5 rounded-sm transition-colors uppercase tracking-wider">
            查看全球航线
          </a>
        </div>
        
        <div class="flex items-center space-x-6 text-xs font-mono text-slate-500 uppercase">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Network Online</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Global Routes</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>24/7 Available</span>
          </div>
        </div>
      </div>
      
      <!-- Right Visual: Control Panel -->
      <div class="relative hidden lg:block h-[500px] w-full rounded-xl border border-white/10 bg-brand-navy shadow-2xl overflow-hidden p-6">
        <div class="absolute inset-0 bg-gradient-to-br from-brand-neon/5 to-transparent"></div>
        
        <!-- Header of Panel -->
        <div class="flex justify-between items-center border-b border-white/10 pb-4 mb-6">
          <div class="font-mono text-xs text-slate-400 tracking-widest">GLOBAL ROUTE CONTROL</div>
          <div class="flex space-x-2">
            <div class="w-2 h-2 rounded-full bg-red-500/50"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-500/50"></div>
            <div class="w-2 h-2 rounded-full bg-green-500/80 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></div>
          </div>
        </div>
        
        <!-- Simplified Map abstraction -->
        <div class="relative h-64 border border-white/5 bg-black/20 rounded-md mb-6 overflow-hidden flex items-center justify-center">
          <svg class="w-full h-full text-white/5 opacity-50" viewBox="0 0 800 400" fill="currentColor">
            <!-- Very abstract dotted map shapes -->
            <path d="M600,100 Q650,50 700,100 T750,150" stroke="var(--color-brand-neon)" stroke-width="2" fill="none" stroke-dasharray="4,4" class="opacity-50" />
            <path d="M200,150 Q300,100 400,150 T600,200" stroke="var(--color-brand-neon)" stroke-width="2" fill="none" class="animate-pulse-slow" />
            
            <!-- Nodes -->
            <circle cx="200" cy="150" r="4" fill="var(--color-brand-accent)" />
            <circle cx="400" cy="150" r="3" fill="var(--color-brand-neon)" />
            <circle cx="600" cy="200" r="4" fill="white" />
            <circle cx="700" cy="100" r="3" fill="var(--color-brand-neon)" />
          </svg>
          
          <!-- Node labels -->
          <div class="absolute top-1/3 left-1/4 transform -translate-x-1/2 -translate-y-1/2 font-mono text-[10px] text-brand-accent bg-black/50 px-1 border border-brand-accent/30">ASIA-01</div>
          <div class="absolute top-1/2 left-3/4 transform -translate-x-1/2 -translate-y-1/2 font-mono text-[10px] text-white bg-black/50 px-1 border border-white/30">US-WEST</div>
        </div>
        
        <!-- Status Cards -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-black/30 border border-white/5 rounded-md p-3">
            <div class="text-[10px] text-slate-500 font-mono mb-1">FLIGHT OA-001</div>
            <div class="text-sm font-bold text-brand-neon font-mono">STATUS: CONNECTED</div>
            <div class="text-xs text-slate-400 mt-2">ROUTE: ASIA → GLOBAL</div>
          </div>
          <div class="bg-black/30 border border-white/5 rounded-md p-3">
            <div class="text-[10px] text-slate-500 font-mono mb-1">CURRENT GATE</div>
            <div class="text-sm font-bold text-green-400 font-mono">ONLINE</div>
            <div class="text-xs text-slate-400 mt-2">SECURE TUNNEL ACTIVE</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Global Network Departure Board -->
  <section id="board" class="py-20 bg-brand-dark relative border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="text-brand-accent font-mono tracking-[0.3em] text-sm mb-2">DEPARTURES</h2>
        <p class="text-3xl font-bold">全球网络出发板</p>
      </div>
      
      <div class="bg-black/80 rounded-lg border border-white/10 p-1 overflow-x-auto">
        <table class="w-full text-left font-mono min-w-[800px] relative">
          <thead class="bg-white/5">
            <tr class="text-slate-500 text-[10px] sm:text-xs border-b border-white/10 uppercase tracking-wider">
              <th class="py-3 px-4 font-normal">BRAND / 航班</th>
              <th class="py-3 px-4 font-normal">FEATURES / 特性</th>
              <th class="py-3 px-4 font-normal">PROMO / 优惠</th>
              <th class="py-3 px-4 font-normal text-right">STATUS</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-white/5 text-slate-300">
            {brands.slice(0, 5).map((brand, i) => {
              const statuses = ['AVAILABLE', 'READY', 'ONLINE'];
              const statusColors = ['text-green-400', 'text-brand-accent', 'text-green-400'];
              const statusIndex = i % 3;
              
              return (
                <tr class="hover:bg-white/5 transition-colors group cursor-default">
                  <td class="py-4 px-4 font-bold text-white group-hover:text-brand-neon">{brand.name.replace('：', '')}</td>
                  <td class="py-4 px-4 text-xs text-slate-400 truncate max-w-[300px]">
                    {brand.features[0] || '全节点优化覆盖'}
                  </td>
                  <td class="py-4 px-4 text-xs text-slate-400">
                    {brand.discount && brand.discount !== '(暂无优惠）' ? brand.discount : '-'}
                  </td>
                  <td class={`flight-status py-4 px-4 text-right ${statusColors[statusIndex]} font-bold tracking-widest`} data-current-color={statusColors[statusIndex]}>
                    {statuses[statusIndex]}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
      <div class="mt-8 text-center">
        <a href="/network" class="inline-flex items-center text-sm font-medium text-brand-neon hover:text-white transition-colors">
          探索全球网络 <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    // Client-side script for Departure Board flickering effect
    document.addEventListener('DOMContentLoaded', () => {
      const allStatuses = [
        { text: 'AVAILABLE', color: 'text-green-400' },
        { text: 'READY', color: 'text-brand-accent' },
        { text: 'ONLINE', color: 'text-green-400' },
        { text: 'ON TIME', color: 'text-blue-400' },
        { text: 'BOARDING', color: 'text-yellow-400' }
      ];
      
      const elements = document.querySelectorAll('.flight-status');
      
      const flicker = (el) => {
        if (el.dataset.flickering === 'true') return;
        el.dataset.flickering = 'true';
        
        let flickers = 0;
        const maxFlickers = Math.floor(Math.random() * 3) + 2;
        const finalStatus = allStatuses[Math.floor(Math.random() * allStatuses.length)];
        const prevColor = el.getAttribute('data-current-color');
        
        const interval = setInterval(() => {
          flickers++;
          
          const randomStatus = allStatuses[Math.floor(Math.random() * allStatuses.length)];
          el.classList.remove(prevColor);
          el.classList.add('text-white');
          el.textContent = randomStatus.text.replace(/./g, () => Math.random() > 0.5 ? '-' : String.fromCharCode(65 + Math.floor(Math.random() * 26)));
          
          if (flickers >= maxFlickers) {
            clearInterval(interval);
            el.className = `flight-status py-4 px-4 text-right font-bold tracking-widest ${finalStatus.color}`;
            el.setAttribute('data-current-color', finalStatus.color);
            el.textContent = finalStatus.text;
            el.dataset.flickering = 'false';
          }
        }, 100);
      };
      
      setInterval(() => {
        const numToChange = Math.floor(Math.random() * 4) + 2;
        for (let i = 0; i < numToChange; i++) {
          const randomIdx = Math.floor(Math.random() * elements.length);
          if (elements[randomIdx]) {
            flicker(elements[randomIdx]);
          }
        }
      }, 1500);
    });
  </script>

  <!-- 3. Brand Advantages (Boarding Passes) -->
  <section class="py-24 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <h2 class="text-3xl font-bold mb-4">为什么选择海外机场？</h2>
        <p class="text-slate-400 max-w-2xl">提供专业、稳定、易用的全球网络连接服务，让您的每一次访问都如航班般准点抵达。</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Pass 1 -->
        <div class="bg-white text-brand-navy rounded-lg overflow-hidden flex flex-col relative group transform transition-transform duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-neon/20 border-l-[12px] border-brand-accent">
          <!-- Cutout effect -->
          <div class="absolute -left-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          <div class="absolute -right-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          
          <div class="p-6 border-b-2 border-dashed border-slate-300">
            <div class="flex justify-between items-center mb-6 text-xs font-mono text-slate-500">
              <span>BOARDING PASS</span>
              <span class="font-bold">01</span>
            </div>
            <h3 class="text-xl font-bold mb-2">稳定连接</h3>
            <div class="text-sm text-slate-600 font-mono">GATE: RELIABILITY</div>
          </div>
          <div class="p-6 flex-grow bg-slate-50">
            <p class="text-sm text-slate-700 leading-relaxed">在复杂网络环境下提供更顺畅的连接体验，减少丢包与波动，确保数据传输的连续性。</p>
          </div>
        </div>

        <!-- Pass 2 -->
        <div class="bg-white text-brand-navy rounded-lg overflow-hidden flex flex-col relative group transform transition-transform duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-neon/20 border-l-[12px] border-brand-neon">
          <div class="absolute -left-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          <div class="absolute -right-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          
          <div class="p-6 border-b-2 border-dashed border-slate-300">
            <div class="flex justify-between items-center mb-6 text-xs font-mono text-slate-500">
              <span>BOARDING PASS</span>
              <span class="font-bold">02</span>
            </div>
            <h3 class="text-xl font-bold mb-2">全球访问</h3>
            <div class="text-sm text-slate-600 font-mono">GATE: WORLDWIDE</div>
          </div>
          <div class="p-6 flex-grow bg-slate-50">
            <p class="text-sm text-slate-700 leading-relaxed">面向海外网站、流媒体、AI 工具与在线服务场景，打破地域限制，自由探索全球网络资源。</p>
          </div>
        </div>

        <!-- Pass 3 -->
        <div class="bg-white text-brand-navy rounded-lg overflow-hidden flex flex-col relative group transform transition-transform duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-neon/20 border-l-[12px] border-slate-800">
          <div class="absolute -left-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          <div class="absolute -right-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          
          <div class="p-6 border-b-2 border-dashed border-slate-300">
            <div class="flex justify-between items-center mb-6 text-xs font-mono text-slate-500">
              <span>BOARDING PASS</span>
              <span class="font-bold">03</span>
            </div>
            <h3 class="text-xl font-bold mb-2">多设备使用</h3>
            <div class="text-sm text-slate-600 font-mono">GATE: COMPATIBILITY</div>
          </div>
          <div class="p-6 flex-grow bg-slate-50">
            <p class="text-sm text-slate-700 leading-relaxed">兼容常见桌面与移动设备使用方式，支持 Windows、macOS、iOS、Android 及常见路由器系统。</p>
          </div>
        </div>

        <!-- Pass 4 -->
        <div class="bg-white text-brand-navy rounded-lg overflow-hidden flex flex-col relative group transform transition-transform duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-neon/20 border-l-[12px] border-green-500">
          <div class="absolute -left-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          <div class="absolute -right-3 top-1/2 w-6 h-6 bg-brand-navy rounded-full transform -translate-y-1/2"></div>
          
          <div class="p-6 border-b-2 border-dashed border-slate-300">
            <div class="flex justify-between items-center mb-6 text-xs font-mono text-slate-500">
              <span>BOARDING PASS</span>
              <span class="font-bold">04</span>
            </div>
            <h3 class="text-xl font-bold mb-2">简单上手</h3>
            <div class="text-sm text-slate-600 font-mono">GATE: EASY-BOARD</div>
          </div>
          <div class="p-6 flex-grow bg-slate-50">
            <p class="text-sm text-slate-700 leading-relaxed">降低初次配置与使用的理解门槛，提供清晰详尽的图文教程，小白用户也能快速完成“登机”。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Use Cases (Destination Cards) -->
  <section id="destinations" class="py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-brand-accent font-mono tracking-[0.2em] text-sm mb-2 uppercase">Choose Your Destination</h2>
        <p class="text-3xl font-bold">你准备飞往哪里？</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            { num: "01", title: "AI 工具", desc: "连接海外 AI 与常见在线工具的网络环境需求，如 ChatGPT, Claude, Midjourney 等。" },
            { num: "02", title: "流媒体娱乐", desc: "流畅观看全球高清流媒体内容，支持 Netflix, YouTube Premium, Disney+ 等平台的原生体验。" },
            { num: "03", title: "海外网站", desc: "快速访问全球各类资讯、学术、设计、技术类网站，获取一手国际信息。" },
            { num: "04", title: "远程办公", desc: "为跨国团队协作提供稳定的网络基础，顺畅使用 Zoom, Slack, Google Workspace 等工具。" },
            { num: "05", title: "开发者服务", desc: "加速 GitHub, Docker Hub, NPM 等开发资源的访问与拉取，提升开发与部署效率。" },
            { num: "06", title: "跨境学习", desc: "稳定连接海外高校内网、学术数据库及 Coursera 等在线教育平台。" }
          ].map((item) => (
            <a href="/use-cases" class="group block bg-brand-navy border border-white/10 rounded-lg p-6 hover:border-brand-neon/50 transition-colors relative overflow-hidden">
              <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                <svg class="w-16 h-16 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
              </div>
              <div class="text-xs font-mono tracking-widest text-slate-500 mb-4 border-b border-white/10 pb-4 inline-block w-full">DESTINATION {item.num}</div>
              <h3 class="text-xl font-bold mb-3 text-white group-hover:text-brand-neon transition-colors">{item.title}</h3>
              <p class="text-sm text-slate-400 relative z-10">{item.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. Route Technology -->
  <section class="py-24 bg-brand-navy border-y border-white/5 relative overflow-hidden">
    <div class="absolute right-0 top-1/2 transform -translate-y-1/2 w-1/3 h-full bg-gradient-to-l from-brand-neon/5 to-transparent pointer-events-none hidden lg:block"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Visual -->
        <div class="order-2 lg:order-1 border border-white/10 rounded-xl p-8 bg-brand-dark relative">
          <div class="font-mono text-xs text-brand-neon mb-8">SYSTEM ARCHITECTURE // ROUTES</div>
          <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-700 before:to-transparent">
            
