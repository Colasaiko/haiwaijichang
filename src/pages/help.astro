---
import Layout from '../layouts/Layout.astro';

import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'help');
const { title, description, keywords, h1, badge, heroText, quickLinks, routeHelpLinkText, scenarioHelpLinkText, troubleshooting, contact, categories, hotTopics = [
  { name: 'Clash 下载', href: '/help/windows-guide' },
  { name: '无法连接', href: '/help/connected-but-no-internet' },
  { name: '订阅更新', href: '/help/subscription-update-failed' },
  { name: '节点 Timeout', href: '/help/nodes-timeout' },
  { name: 'ChatGPT 风控', href: '/help/ai-tools-access' }
] } = page.data;
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
>
  <!-- 1. Hero & Search -->
  <section class="pt-32 pb-16 bg-brand-navy border-b border-white/5 relative overflow-hidden">
    <!-- Subtle Background Graphic -->
    <div class="absolute inset-0 z-0 flex items-center justify-center opacity-10 pointer-events-none">
      <svg class="w-full max-w-5xl" viewBox="0 0 1000 400" fill="none" stroke="currentColor">
        <circle cx="500" cy="200" r="150" stroke-width="1" stroke-dasharray="4 4" />
        <circle cx="500" cy="200" r="250" stroke-width="1" stroke-dasharray="4 4" />
        <line x1="100" y1="200" x2="900" y2="200" stroke-width="1" />
        <line x1="500" y1="0" x2="500" y2="400" stroke-width="1" />
      </svg>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-brand-accent/10 border border-brand-accent/20 mb-8">
        <svg class="w-4 h-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs font-mono tracking-[0.2em] text-brand-accent uppercase">Airport Information Desk</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-8 text-white">
        有什么可以帮你？
      </h1>

      <!-- Search Bar -->
      <div class="relative max-w-2xl mx-auto mb-12">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <input 
          type="text" 
          class="block w-full pl-12 pr-4 py-4 bg-black/50 border border-white/20 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-neon focus:border-transparent transition-all shadow-xl"
          placeholder="搜索：Windows、Clash、订阅、无法连接、更新配置……" 
        />
        <div class="absolute inset-y-0 right-0 pr-2 flex items-center">
          <button class="px-4 py-2 bg-brand-accent hover:bg-yellow-400 text-brand-dark font-bold text-sm rounded-lg transition-colors uppercase tracking-wider">
            Search
          </button>
        </div>
      </div>

      <!-- Hot Topics -->
      <div>
        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-4">热门常见问题</h3>
        <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto">
          {hotTopics.map(topic => (
            <a href={topic.href} class="px-3 py-1.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-xs text-slate-300 hover:text-white transition-colors">
              {topic.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Main Help Categories -->
  <section class="py-20 bg-brand-dark relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        {categories.map(category => (
          <div class="bg-brand-navy border border-white/10 rounded-xl p-6 hover:border-white/20 transition-all flex flex-col h-full">
            <div class="flex items-center space-x-3 mb-6">
              <div class="w-10 h-10 bg-white/5 border border-white/10 rounded flex items-center justify-center text-brand-neon">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={category.icon} /></svg>
              </div>
              <div>
                <h2 class="text-xs font-mono text-slate-500 tracking-widest uppercase mb-0.5">{category.enTitle}</h2>
                <h3 class="text-lg font-bold text-white">{category.zhTitle}</h3>
              </div>
            </div>

            <ul class="space-y-3 flex-grow">
              {category.isDevice ? (
                // Device list layout
                category.links.map(device => (
                  <li>
                    <a href={device.href} class="flex justify-between items-center p-3 bg-white/5 hover:bg-white/10 rounded border border-transparent hover:border-white/10 transition-colors group">
                      <span class="font-bold text-sm text-slate-200 group-hover:text-brand-neon">{device.name}</span>
                      <span class="text-xs text-slate-500">{device.desc}</span>
                    </a>
                  </li>
                ))
              ) : (
                // Normal link list layout
                category.links.map(link => (
                  <li>
                    <a href={link.href} class="flex items-start text-sm text-slate-400 hover:text-white group">
                      <svg class="w-4 h-4 text-slate-600 group-hover:text-brand-neon mt-0.5 mr-2 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      <span>{link.name}</span>
                    </a>
                  </li>
                ))
              )}
            </ul>
            
            {category.enTitle === "ROUTE HELP" && (
              <a href="/technology" class="mt-6 block w-full py-2 bg-white/5 text-center text-xs text-slate-400 hover:text-white rounded border border-white/10 transition-colors uppercase tracking-widest">{routeHelpLinkText}</a>
            )}
            
            {category.enTitle === "SCENARIO HELP" && (
              <a href="/use-cases" class="mt-6 block w-full py-2 bg-white/5 text-center text-xs text-slate-400 hover:text-white rounded border border-white/10 transition-colors uppercase tracking-widest">{scenarioHelpLinkText}</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Troubleshooting Step-by-Step Preview -->
  <section class="py-20 bg-brand-navy border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-sm font-mono tracking-widest text-brand-accent uppercase mb-2">{troubleshooting.badge}</h2>
        <h3 class="text-3xl font-bold">{troubleshooting.title}</h3>
        <p class="text-slate-400 mt-4">{troubleshooting.desc}</p>
      </div>

      <div class="relative">
        <div class="hidden md:block absolute top-6 left-10 right-10 h-0.5 bg-white/10 -z-10"></div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          {troubleshooting.steps.map(item => (
            <div class="bg-black/40 border border-white/10 rounded-lg p-5 text-center relative z-10 flex flex-col items-center hover:border-brand-accent transition-colors cursor-default">
              <div class="w-12 h-12 bg-brand-dark border-2 border-brand-accent rounded-full flex items-center justify-center text-xs font-mono font-bold text-brand-accent mb-4">
                {item.step.split(' ')[1]}
              </div>
              <h4 class="font-bold text-white mb-2 text-sm">{item.title}</h4>
              <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Contact Support -->
  <section class="py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-white/5 border border-white/10 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-neon">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      </div>
      <h2 class="text-3xl font-bold mb-4">{contact.title}</h2>
      <p class="text-slate-400 mb-10 max-w-xl mx-auto">
        {contact.desc}
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="https://t.me/ColaSaiko15" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-3.5 bg-[#2AABEE] text-white font-bold rounded hover:bg-[#229ED9] transition-colors shadow-lg shadow-[#2AABEE]/20">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.94z"/></svg>
          {contact.telegram}
        </a>
        <a href="mailto:colasaiko15@gmail.com" class="inline-flex items-center justify-center px-8 py-3.5 bg-white/10 text-white font-bold rounded hover:bg-white/20 transition-colors border border-white/10">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {contact.email}
        </a>
      </div>
    </div>
  </section>

</Layout>
