---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

import { getCollection, getEntry } from 'astro:content';
const brandEntries = await getCollection('brands');
const brands = brandEntries.map(e => ({ id: e.id, ...e.data })).sort((a, b) => (a.order || 999) - (b.order || 999));

const page = await getEntry('pages', 'ladder-recommendation');
const { title, description, h1, subtitle, h2_1, p1_1, h2_2, p2_1, h2_3, p3_1, noResults, viewDetails } = page.data;

// Filter brands relevant to this topic
const matchedBrands = '' 
  ? brands.filter(b => b.features.join(' ').toLowerCase().includes('')) 
  : brands.slice(0, 6);

---
<Layout title={title} description={description}>
  <section class="pt-32 pb-16 bg-brand-navy border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{h1}</h1>
      <p class="text-lg text-slate-400">{subtitle}</p>
    </div>
  </section>

  <section class="py-16 bg-brand-dark min-h-screen">
    <div class="max-w-4xl mx-auto px-4 prose prose-invert prose-brand">
      <h2>{h2_1}</h2>
      <p>{p1_1}</p>
      
      <h2>{h2_2}</h2>
      <p>{p2_1}</p>
      
      <div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-6 mt-8 mb-12">
        {matchedBrands.length > 0 ? matchedBrands.map(b => (
          <a href={`/brands/${b.slug}`} class="block bg-brand-navy border border-white/10 p-6 rounded-xl hover:border-brand-neon transition-colors">
            <h3 class="text-xl font-bold text-white mb-2">{b.name}</h3>
            <p class="text-sm text-slate-400 line-clamp-2">{b.features[0]}</p>
            <div class="mt-4 text-xs font-mono text-brand-neon">{viewDetails}</div>
          </a>
        )) : <p class="text-slate-500">{noResults}</p>}
      </div>
      
      <h2>{h2_3}</h2>
      <p set:html={p3_1.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')} />
    </div>
  </section>
</Layout>
