---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'privacy');
const { title, description, h1, heroSubtitle, lastUpdated, intro, sections, contactTitle, contactIntro } = page.data;
---

<Layout 
  title={title}
  description={description}
>
  <!-- 1. Page Header -->
  <section class="pt-32 pb-16 bg-brand-navy border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 mb-8">
        <svg class="w-4 h-4 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span class="text-xs font-mono tracking-[0.2em] text-slate-300 uppercase">Legal Document</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-white">
        {h1}
      </h1>
      <h2 class="text-lg font-mono text-brand-neon tracking-[0.2em] mb-8 uppercase">
        {heroSubtitle}
      </h2>
      
      <p class="text-sm font-mono text-slate-500">
        Last updated: {lastUpdated}
      </p>
    </div>
  </section>

  <!-- 2. Content Body -->
  <section class="py-16 bg-brand-dark relative z-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-brand-navy border border-white/10 rounded-xl p-8 md:p-12 shadow-2xl">
        <div class="prose prose-invert prose-slate max-w-none">
          <p class="text-slate-300 leading-relaxed mb-12">
            {intro}
          </p>

          <div class="space-y-12">
            {sections.map(section => (
              <div id={section.id} class="scroll-mt-24">
                <h3 class="text-xl font-bold text-white mb-4 border-b border-white/10 pb-2">{section.title}</h3>
                <div class="text-slate-400 leading-relaxed text-sm" set:html={section.content}></div>
              </div>
            ))}
          </div>

          <!-- Contact Block -->
          <div class="mt-16 pt-8 border-t border-white/10">
            <h3 class="text-xl font-bold text-white mb-4">{contactTitle}</h3>
            <p class="text-slate-400 text-sm mb-6">
              {contactIntro}
            </p>
            <div class="flex flex-col space-y-4 font-mono text-sm">
              <a href="mailto:colasaiko15@gmail.com" class="flex items-center text-brand-neon hover:text-white transition-colors">
                <svg class="w-5 h-5 mr-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Email: colasaiko15@gmail.com
              </a>
              <a href="https://t.me/ColaSaiko15" target="_blank" rel="noopener noreferrer" class="flex items-center text-brand-neon hover:text-white transition-colors">
                <svg class="w-5 h-5 mr-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                Telegram: @ColaSaiko15
              </a>
              <a href="/help" class="flex items-center text-brand-neon hover:text-white transition-colors">
                <svg class="w-5 h-5 mr-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                前往机场服务台 (Help Center)
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

</Layout>
