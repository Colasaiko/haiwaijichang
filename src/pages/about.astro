---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const { title, description, hero, concept, focus, avoid, passengers, roadmap, bottomBanner } = page.data;
---
<Layout title={title} description={description}>
  <!-- 1. Hero: Terminal Story Wall -->
  <section class="pt-32 pb-24 bg-brand-navy border-b border-white/5 relative overflow-hidden">
    <!-- Quiet Background: Large Typographic Watermark -->
    <div class="absolute -left-10 top-20 text-[15rem] font-bold text-white/[0.02] font-mono leading-none pointer-events-none select-none whitespace-nowrap">
      OVERSEAS
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center mt-12">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 mb-8">
        <svg class="w-4 h-4 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs font-mono tracking-[0.2em] text-slate-300 uppercase">{hero.tag}</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-white">
        {hero.h1}
      </h1>
      <h2 class="text-lg md:text-xl font-mono text-brand-accent tracking-[0.2em] mb-12">
        {hero.h2}
      </h2>
      
      <p class="text-2xl md:text-3xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-light" set:html={hero.text}></p>
    </div>
  </section>

  <!-- 2. Brand Concept / Why the name -->
  <section class="py-24 bg-brand-dark relative z-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row gap-16 items-center">
        <div class="w-full md:w-5/12">
          <div class="aspect-[4/5] bg-brand-navy border border-white/10 rounded-2xl relative overflow-hidden flex flex-col p-8 justify-between">
            <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(var(--color-brand-neon) 1px, transparent 1px); background-size: 20px 20px;"></div>
            <div class="relative z-10">
              <svg class="w-10 h-10 text-brand-neon mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-2">{concept.tag}</div>
              <h3 class="text-2xl font-bold text-white mb-2" set:html={concept.title}></h3>
            </div>
            <div class="relative z-10 text-[10px] font-mono text-brand-neon/50 tracking-widest break-all">
              TKT: {concept.ticket.tkt}<br/>
              GATE: {concept.ticket.gate}<br/>
              CLASS: {concept.ticket.class}
            </div>
          </div>
        </div>
        
        <div class="w-full md:w-7/12 space-y-6 text-slate-300 leading-relaxed text-lg">
          {concept.paragraphs.map((p: string) => (
            <p set:html={p}></p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What we focus on & What we avoid -->
  <section class="py-24 bg-brand-navy border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Focus -->
        <div>
          <h3 class="text-xs font-mono text-brand-neon uppercase tracking-widest mb-4">{focus.tag}</h3>
          <h4 class="text-3xl font-bold text-white mb-10">{focus.title}</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {focus.items.map((item: {title: string, desc: string}) => (
              <div class="bg-black/30 border border-white/5 rounded-xl p-6 hover:border-brand-neon/30 transition-colors">
                <div class="text-xl font-bold text-white mb-2">{item.title}</div>
                <p class="text-sm text-slate-400">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Avoid -->
        <div>
          <h3 class="text-xs font-mono text-brand-accent uppercase tracking-widest mb-4">{avoid.tag}</h3>
          <h4 class="text-3xl font-bold text-white mb-10">{avoid.title}</h4>
          <div class="space-y-4">
            {avoid.items.map((item: string) => (
              <div class="flex items-center space-x-4 bg-brand-dark border border-white/5 rounded-lg p-5">
                <div class="w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                <span class="text-slate-300 font-medium">{item}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Who is this for -->
  <section class="py-24 bg-brand-dark border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-4">{passengers.tag}</h3>
      <h4 class="text-3xl font-bold text-white mb-12">{passengers.title}</h4>
      
      <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
        {passengers.items.map((user: string) => (
          <div class="px-6 py-3 bg-white/5 border border-white/10 rounded-full text-slate-300 text-sm font-medium hover:text-white hover:border-white/30 transition-colors">
            {user}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Roadmap (Flight Route Style) -->
  <section class="py-24 bg-brand-navy border-t border-white/5">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h3 class="text-xs font-mono text-brand-neon uppercase tracking-widest mb-4">{roadmap.tag}</h3>
        <h4 class="text-3xl font-bold text-white">{roadmap.title}</h4>
      </div>

      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-white/10 -z-10 -mt-0.5"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-4 relative z-10">
          {roadmap.items.map((item: {step: string, title: string, sub: string, desc: string}) => (
            <div class="flex flex-col items-center md:items-start bg-brand-dark md:bg-transparent p-6 md:p-0 rounded-xl md:rounded-none border border-white/5 md:border-none relative group">
              <!-- Node dot on the line (desktop only) -->
              <div class="hidden md:flex w-10 h-10 bg-brand-navy border-4 border-brand-neon rounded-full items-center justify-center mx-auto mb-6 absolute left-1/2 -translate-x-1/2 -top-5 z-20 group-hover:scale-110 transition-transform">
                <span class="text-[10px] font-bold text-white">{item.step}</span>
              </div>
              
              <!-- Mobile Step Number -->
              <div class="md:hidden text-2xl font-mono font-bold text-brand-neon/30 mb-2">{item.step}</div>
              
              <div class="md:text-center w-full md:mt-12 text-center">
                <h5 class="text-lg font-bold text-white font-mono">{item.title}</h5>
                <p class="text-xs text-brand-neon tracking-widest uppercase mb-4">{item.sub}</p>
                <p class="text-sm text-slate-400 leading-relaxed md:max-w-[200px] mx-auto">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Bottom Banner / Contact -->
  <section class="py-24 bg-brand-dark border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 leading-relaxed" set:html={bottomBanner.title}></h2>
      
      <div class="mt-12 flex justify-center space-x-6 text-sm font-bold tracking-widest uppercase">
        {bottomBanner.links.map((link: {text: string, href: string}) => (
          <a href={link.href} class="text-slate-400 hover:text-white transition-colors">{link.text}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>
